{
  "repos": {
    "owner/repo": {
      "localPath": "~/dev/repo",
      "enabled": true
    }
  },
  "review": {
    "agents": [
      "code-reviewer"
    ],
    "model": "sonnet",
    "maxTurns": 0,
    "timeoutSec": 3600,
    "maxDiffLines": 0,
    "maxChangedFiles": 0,
    "skipDrafts": true,
    "rereviewOnNewCommits": true,
    "includeExts": [],
    "excludeGlobs": [
      "package-lock.json",
      "yarn.lock",
      "dist/",
      ".min.js"
    ],
    "verify": {
      "enabled": true,
      "model": "haiku",
      "timeoutSec": 300,
      "maxTurns": 15,
      "workers": 4
    },
    "batchMaxFiles": 20,
    "batchMaxChars": 120000,
    "workers": 2,
    "parallel": true,
    "integrationMode": "single",
    "runtime": {
      "enabled": true,
      "model": "sonnet",
      "maxTurns": 40,
      "planTimeoutSec": 600,
      "setupTimeoutSec": 900,
      "testTimeoutSec": 900,
      "browserTimeoutSec": 300,
      "image": "mcr.microsoft.com/playwright:v1.58.2-noble",
      "imagePullTimeoutSec": 900,
      "browserInstallTimeoutSec": 300,
      "installAttempts": 3,
      "installRetryDelaySec": 30,
      "memory": "6g",
      "cpus": 4,
      "baseline": true,
      "recoveryAttempts": 2,
      "browserLocale": "ko-KR",
      "minFreeDiskGiB": 3
    },
    "recoveryAttempts": 2
  },
  "post": {
    "dryRun": true,
    "maxFindingsPerPR": 15,
    "minSeverity": "nit",
    "autonomous": true,
    "allowedEvents": [
      "COMMENT",
      "APPROVE",
      "REQUEST_CHANGES"
    ],
    "judgeModel": "opus"
  },
  "limits": {
    "maxPerTick": 2
  },
  "repomind": {
    "enabled": false,
    "url": "http://repomind.internal:8798/mcp",
    "keychainService": "review-bot-repomind",
    "keychainAccount": "",
    "tools": [
      "impact",
      "rationale",
      "search",
      "related",
      "coupling",
      "overview"
    ],
    "timeoutSec": 20,
    "required": true
  },
  "notify": {
    "enabled": true,
    "sound": "Glass"
  },
  "insights": {
    "enabled": false,
    "model": "claude-sonnet-5-5",
    "maxPerTick": 3,
    "timeoutSec": 90,
    "maxTokens": 8192,
    "workspaceID": ""
  }
}
