{
  "repos": {
    "owner/repo": {
      "localPath": "~/dev/repo",
      "enabled": true
    }
  },
  "review": {
    "agents": [
      "code-reviewer"
    ],
    "model": "sonnet",
    "maxTurns": 0,
    "timeoutSec": 3600,
    "maxDiffLines": 0,
    "maxChangedFiles": 0,
    "skipDrafts": true,
    "rereviewOnNewCommits": true,
    "includeExts": [],
    "excludeGlobs": [
      "package-lock.json",
      "yarn.lock",
      "dist/",
      ".min.js"
    ],
    "verify": {
      "enabled": true,
      "model": "haiku",
      "timeoutSec": 300,
      "maxTurns": 15,
      "workers": 4
    },
    "batchMaxFiles": 20,
    "batchMaxChars": 120000,
    "workers": 2,
    "parallel": true,
    "integrationMode": "single"
  },
  "post": {
    "dryRun": true,
    "maxFindingsPerPR": 15,
    "minSeverity": "nit",
    "autonomous": true,
    "allowedEvents": [
      "COMMENT",
      "APPROVE",
      "REQUEST_CHANGES"
    ],
    "judgeModel": "opus"
  },
  "limits": {
    "maxPerTick": 2
  },
  "repomind": {
    "enabled": false,
    "url": "http://repomind.internal:8798/mcp",
    "keychainService": "review-bot-repomind",
    "keychainAccount": "",
    "tools": [
      "impact",
      "rationale",
      "search",
      "related",
      "coupling",
      "overview"
    ],
    "timeoutSec": 20,
    "required": true
  },
  "notify": {
    "enabled": true,
    "sound": "Glass"
  }
}
