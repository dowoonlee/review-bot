def cmd_doctor(args, cfg):
    ok = True
    for tool in ("gh", "git", "claude"):
        p = shutil.which(tool)
        print("%-8s %s" % (tool, p or "없음 ❌"))
        ok = ok and bool(p)
    print("%-8s %s (전역 활성)" % ("gh 계정", gh.active_account() or "미인증 ❌"))
    for acct, repos in _accounts(cfg).items():
        if not acct:
            print("%-8s 고정 안 됨 — 활성 계정을 따라갑니다. 계정이 둘이면 config 에 account 를 적으세요 ⚠️"
                  % "계정")
            continue
        try:
            me = gh.whoami(acct)
            good = (me or "").lower() == acct.lower()
            print("%-8s %s → 토큰 주인 %s %s" % ("고정 계정", acct, me, "✓" if good else "❌ 불일치"))
            ok = ok and good
        except gh.GhError as e:
            print("%-8s %s ❌ %s" % ("고정 계정", acct, str(e)[:80]))
            ok = False
    repos = cfg.get("repos") or {}
    if not repos:
        print("설정   저장소 화이트리스트가 비어 있습니다 — 아무것도 리뷰하지 않습니다 ⚠️")
    for repo, e in repos.items():
        lp = os.path.expanduser(e.get("localPath") or "")
        state = "로컬 클론 %s" % ("있음" if lp and os.path.isdir(os.path.join(lp, ".git"))
                                   else "없음 (봇 캐시에 clone 합니다)")
        print("%-8s %s — %s" % ("저장소", repo, state))
    missing = []
    for a in cfg["review"]["agents"]:
        f = os.path.join(agents_mod.AGENTS_DIR, a + ".md")
        here = os.path.exists(f)
        print("%-8s %s %s" % ("리뷰어", a, "✓" if here else "❌ 정의 없음"))
        if not here:
            missing.append(a)
        ok = ok and here
    if missing:
        bundled = [f[:-3] for f in os.listdir(BUNDLED_AGENTS)
                   if f.endswith(".md")] if os.path.isdir(BUNDLED_AGENTS) else []
        if [m for m in missing if m in bundled]:
            print("         → `review-bot setup` 이 번들 리뷰어를 설치합니다")
        else:
            print("         → `review-bot agent add <정의.md>` 로 등록하거나, "
                  "`review-bot agent remove <이름>` 으로 목록에서 빼세요")
    print("\n%s" % ("점검 통과" if ok else "빠진 것이 있습니다"))
    return 0 if ok else 1


def _install_signal_handlers():
    """SIGTERM·SIGHUP 을 받으면 자식을 정리하고 나간다.

    기본 동작은 즉시 종료라 finally 가 돌지 않는다. 그러면 별도 프로세스 그룹에
    띄운 claude 가 고아로 남아 끝까지 돈다 — launchd 가 틱을 정리할 때 실제로
    그랬다. 여기서 먼저 자식을 죽이고, lock 도 놓고 나간다.
    """
    def bye(signum, _frame):
        killed = reviewer.kill_children()
        _log("신호 %d 를 받아 정리하고 종료합니다%s"
             % (signum, " — 리뷰어 %d개 종료" % killed if killed else ""))
        try:
            store.release_lock()
        except OSError:
            pass
        # 기본 처리로 되돌려 놓고 자신에게 다시 보낸다. 종료 코드가 신호를 그대로
        # 반영해야 launchd 가 왜 죽었는지 안다.
        signal.signal(signum, signal.SIG_DFL)
        os.kill(os.getpid(), signum)

    for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        try:
            signal.signal(sig, bye)
        except (ValueError, OSError):
            pass                 # 메인 스레드가 아니면 걸 수 없다 — 그냥 넘어간다


