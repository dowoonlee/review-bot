    rp = sub.add_parser("repo", help="감시 저장소 등록·해제·목록")
    rp.add_argument("action", choices=["list", "add", "remove", "enable", "disable"])
    rp.add_argument("target", nargs="?", help="owner/repo")
    rp.add_argument("--path", help="로컬 클론 경로 (worktree 를 여기서 뜬다)")
    rp.add_argument("--account", help="이 저장소에만 쓸 gh 계정")
    rp.add_argument("--config")
    rp.set_defaults(fn=cmd_repo)

    ac = sub.add_parser("account", help="게시에 쓸 gh 계정")
    ac.add_argument("action", choices=["list", "set", "clear"])
