def cmd_forget(args, cfg):
    """이력에서 기록을 지운다.

    runs.jsonl 은 덧붙이기만 하는 파일이라 부분 삭제는 통째로 다시 쓰는 수밖에 없다.
    리뷰가 도는 중에 겹치면 그 사이 덧붙은 기록을 잃으므로 틱과 같은 lock 을 잡는다.
    """
    if getattr(args, 'artifacts', False) and (not args.target or args.all or args.at or args.older_than):
        print('--artifacts 는 PR 하나를 지정할 때만 사용할 수 있습니다.')
        return 2
    if getattr(args, 'dry_run', False) and not getattr(args, 'artifacts', False):
        print('--dry-run 은 --artifacts 와 함께 사용하세요.')
        return 2
    if not (args.target or args.all or args.older_than):
        print("무엇을 지울지 정하세요 — <owner/repo#123> 또는 --all 또는 --older-than <일>")
        return 1
    if not store.acquire_lock():
        _log("틱이 돌고 있습니다 — 끝난 뒤 다시 부르세요.")
        return 1
    try:
        if getattr(args, 'artifacts', False):
            repo, number = _parse_target(args.target)
            report = cleanup.clean_pr(repo, number, reset=args.reset, preview=args.dry_run)
            print(json.dumps(report, ensure_ascii=False, indent=2))
            return 1 if report.get('errors') else 0
        rows = store.read_runs()
        before = len(rows)
        repo = number = None
        if args.target:
            repo, number = _parse_target(args.target)

        cutoff = None
        if args.older_than:
            cutoff = time.strftime(
                "%Y-%m-%dT%H:%M:%S",
                time.localtime(time.time() - float(args.older_than) * 86400))

        def doomed(r):
            if args.all:
                return True
            if repo is not None:
                if r.get("repo") != repo or r.get("number") != number:
                    return False
                if args.at and (r.get("at") or "") != args.at:
                    return False
                return cutoff is None or (r.get("at") or "") < cutoff
            return cutoff is not None and (r.get("at") or "") < cutoff

        keep = [r for r in rows if not doomed(r)]
        removed = before - len(keep)
        if removed:
            store.write_runs(keep)

        # 지문까지 지우면 그 PR 은 "본 적 없는 것" 이 되어 다음 틱에 다시 리뷰한다.
        forgotten = 0
        if args.reset:
            state = store.load()
            for key in list(state):
                if args.all or (repo is not None and key == store.key(repo, number)):
                    del state[key]
                    forgotten += 1
            if forgotten:
                store.save(state)

        print("이력 %d건 삭제 (남은 %d건)" % (removed, len(keep)))
        if forgotten:
            print("처리 지문 %d건도 지웠습니다 — 다음 틱에 다시 리뷰합니다 (비용 발생)"
                  % forgotten)
        return 0
    finally:
        store.release_lock()


def cmd_interval(args, cfg):
    """틱 주기 조회·변경. launchd plist 를 고치고 job 을 다시 올린다."""
    path = _plist_path()
    if not os.path.exists(path):
        print("launchd plist 이 없습니다: %s" % path)
        return 1
    real = os.path.realpath(path)                 # 심볼릭 링크면 원본을 고친다
    try:
        with open(real, "rb") as f:
            data = plistlib.load(f)
    except (OSError, ValueError, plistlib.InvalidFileException) as e:
        print("plist 를 읽지 못했습니다: %s" % e)
        return 1

    cur = data.get("StartInterval") or 0
    if args.minutes is None:
        print("%g분 (%d초)" % (cur / 60.0, cur))
        return 0

    secs = int(round(float(args.minutes) * 60))
    if secs < 60:
        print("최소 1분입니다 — 리뷰 한 건이 보통 15분 넘게 걸립니다")
        return 1
    if secs == cur:
        print("%g분 (그대로)" % (secs / 60.0))
        return 0

    # 다시 올리는 사이 job 이 잠깐 내려가므로, 도는 틱이 있으면 건드리지 않는다.
    lock = _lock_info()
    if lock and lock.get("alive"):
        print("틱이 돌고 있습니다 (pid %s) — 끝난 뒤 바꾸세요" % lock["pid"])
        return 1

    data["StartInterval"] = secs
    tmp = real + ".tmp"
    with open(tmp, "wb") as f:
        plistlib.dump(data, f)
    os.replace(tmp, real)

    uid = os.getuid()
    target = "gui/%d/%s" % (uid, LAUNCHD_LABEL)
    subprocess.run(["launchctl", "bootout", target],
                   capture_output=True, text=True, timeout=30)
    boot = subprocess.run(["launchctl", "bootstrap", "gui/%d" % uid, path],
                          capture_output=True, text=True, timeout=30)
    check = subprocess.run(["launchctl", "print", target],
                           capture_output=True, text=True, timeout=30)
    if check.returncode != 0:
        print("⚠️ job 을 다시 올리지 못했습니다 — 봇이 멈춘 상태입니다.")
        print("   %s" % (boot.stderr or boot.stdout or "").strip()[:200])
        print("   수동 복구: launchctl bootstrap gui/%d %s" % (uid, path))
        return 1
    # job 을 다시 올리면 launchd 의 주기 타이머도 처음부터 다시 센다.
    store.set_schedule_anchor("reload", secs)
    print("%g분 (%d초) — job 을 다시 올렸습니다" % (secs / 60.0, secs))
    return 0


def cmd_mode(args, cfg):
    """게시 모드 토글. 사람 검토를 거칠지 말지는 이 한 값이 정한다."""
    path = args.config or os.path.join(cfg_mod.ROOT, "config.json")
