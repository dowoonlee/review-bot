def _lock_info():
    """지금 틱이 돌고 있는가. lock 파일의 주인이 살아 있어야 진짜다."""
    if not os.path.exists(store.LOCK):
        return None
    try:
        with open(store.LOCK, encoding="utf-8") as f:
            parts = (f.read() or "").split()
        pid = int(parts[0])
        since = parts[1] if len(parts) > 1 else ""
    except (ValueError, OSError, IndexError):
        return None
    try:
        os.kill(pid, 0)
    except OSError:
        return {"pid": pid, "since": since, "alive": False}
    return {"pid": pid, "since": since, "alive": True}


def _paused_info():
    if not store.is_paused():
        return None
    try:
        with open(store.PAUSED, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError:
        lines = []
    return {"at": (lines[0] if lines else ""), "reason": (lines[1] if len(lines) > 1 else "")}


def hold_reason(cfg, pr, me=None):
    """틱이 이 PR 을 리뷰하지 않고 넘기는 이유. process_pr 의 건너뜀 규칙과 같은 사실을
    앱·status 에 미리 보여 준다 — '대기' 로만 떠 있으면 왜 안 오는지 알 길이 없다."""
    author = ((pr.get("prAuthor") or pr.get("author") or "")).lower()
    if me and author == me.lower():
        return "본인 PR — 자동 리뷰하지 않습니다"
    if pr.get("isDraft") and (cfg.get("review") or {}).get("skipDrafts", True):
        return "초안(draft) PR — Ready for review 로 바뀌면 리뷰합니다 (review.skipDrafts)"
    return None


def status_payload(cfg, skip_details=False):
    """앱·스크립트가 읽는 상태 스냅샷. 사람이 읽는 cmd_status 와 같은 사실을 낸다.

    토큰이 필요한 조회는 전부 여기(봇 프로세스) 안에서 끝난다 — 호출하는 쪽은
    키체인도 gh 계정도 알 필요가 없다.
    """
    groups = _accounts(cfg)
    state = store.load()
    accounts, errors, prs = [], drafts_mod.reconcile(cfg), []
    insight_cache = insights.load()
    selection_cache = selection.load()
    selection_settings = selection.registration()
    outgoing, outgoing_errors, outgoing_failed_accounts = [], [], []
    assigned, issue_errors, issue_cache = [], [], issues_mod.load()
    for acct, repos in groups.items():
        info = {"account": acct, "repos": sorted(repos), "tokenOwner": None, "ok": False}
        try:
            me = gh.whoami(acct) if acct else (gh.active_account() or "")
            info["tokenOwner"] = me
            info["ok"] = (not acct) or ((me or "").lower() == (acct or "").lower())
        except gh.GhError as e:
            info["error"] = str(e)[:200]
        accounts.append(info)
        try:
            prs += [dict(p, account=acct or "global") for p in gh.review_requests(account=acct)]
        except gh.GhError as e:
            errors.append("리뷰 요청 조회 실패 (%s): %s" % (acct or "전역 gh", str(e)[:200]))
        try:
            sent, warnings = gh.sent_review_requests(account=acct)
            outgoing.extend(sent)
            outgoing_errors.extend(warnings)
        except gh.GhError as e:
            outgoing_failed_accounts.append(acct or "global")
            outgoing_errors.append("보낸 요청 조회 실패 (%s): %s" % (acct or "전역 gh", str(e)[:200]))
        try:
            rows, warnings = gh.assigned_issues(account=acct)
            assigned.extend(rows)
            issue_errors.extend(warnings)
        except gh.GhError as e:
            issue_errors.append("담당 이슈 조회 실패 (%s): %s" % (acct or "전역 gh", str(e)[:200]))
    credential_state = None
    if insights.settings(cfg)['enabled'] and any(
        insights.keychain_failure(insight_cache.get(insights.key(p.get('account'), p, direction)))
        for direction, rows in (('incoming', prs), ('outgoing', outgoing)) for p in rows
    ):
        credential_state = insight_api.key_state()
    known = set(cfg.get("repos") or {})
    pending = []
    for p in prs:
        rec = state.get(store.key(p["repo"], p["number"])) or {}
        if p["repo"] not in known:
            st = "unwatched"
        elif not rec:
            st = "new"
        elif rec.get("pending"):
            st = "pending"
        elif rec.get('discarded'):
            st = 'discarded'
        elif rec.get("posted") is False:
            st = "draft"
        else:
            st = "posted"
        item = dict(p, watched=p["repo"] in known, status=st,
                    event=rec.get("event"), lastSha=rec.get("sha"))
        me = None
        if p["repo"] in known and not skip_details:
            acct = (cfg_mod.repo_entry(cfg, p["repo"]) or {}).get("account") or cfg.get("account")
            try:
                me = gh.whoami(acct) if acct else (gh.active_account() or "")
                item["requestedBy"] = gh.review_requester(p["repo"], p["number"], me,
                                                          account=acct)
            except gh.GhError:
                item["requestedBy"] = None
            try:
                meta = gh.pr_meta(p["repo"], p["number"], account=acct)
                item["issues"] = gh.linked_issues(p["repo"], p["number"],
                                                  meta.get("title") or p["title"],
                                                  meta.get("body") or "", account=acct)
                item["prAuthor"] = (meta.get("author") or {}).get("login") or p["author"]
                item["isDraft"] = bool(meta.get("isDraft"))
                item["changedFiles"] = meta.get("changedFiles")
            except gh.GhError:
                item["issues"] = []
        item["holdReason"] = hold_reason(cfg, item, me) if p["repo"] in known and not rec else None
        item["insight"] = insights.view(insight_cache, cfg, p.get("account"), p, "incoming", rec, credential_state=credential_state)
        item["insight"]["selection"] = selection.view(selection_cache, selection_settings, p.get("account"), p, "incoming", cfg)
        pending.append(item)
    for p in outgoing:
        p["insight"] = insights.view(insight_cache, cfg, p.get("account"), p, "outgoing", credential_state=credential_state)
        p["insight"]["selection"] = selection.view(selection_cache, selection_settings, p.get("account"), p, "outgoing", cfg)
    assigned = list({(i["account"], i["repo"], i["number"]): i for i in assigned}.values())
    for i in assigned:
        i["watched"] = issues_mod.watched(cfg, i)
        i["jev"] = issues_mod.view(issue_cache, selection_settings, i.get("account"), i, cfg)
        i["rank"] = issues_mod.rank(i, i["jev"])
    visible_tasks = {home_tasks.identity(p["repo"], p["number"], p.get("account"), direction)
                     for direction, rows in (("incoming", pending), ("outgoing", outgoing)) for p in rows}
    try:
        home_tasks.reconcile(visible_tasks)
    except (home_tasks.TaskError, OSError):
        errors.append("완료한 할 일의 새 요청 여부를 확인하지 못했습니다")
    return {
        "at": time.strftime("%Y-%m-%dT%H:%M:%S"),
        "accounts": accounts,
        "repos": sorted(cfg.get("repos") or {}),
        # UI 가 편집하려면 이름만으로는 부족하다 — 켜짐 여부와 로컬 클론까지 준다.
        "repoDetails": [
            {"slug": name,
             "enabled": bool(e.get("enabled", True)),
             "account": e.get("account") or "",
             "localPath": e.get("localPath") or "",
             "cloned": os.path.isdir(os.path.join(
                 os.path.expanduser(e.get("localPath") or "/nonexistent"), ".git"))}
            for name, e in sorted((cfg.get("repos") or {}).items())],
        "dryRun": bool(cfg["post"].get("dryRun", True)),
        "maxPerTick": cfg["limits"].get("maxPerTick") or 2,
        "paused": _paused_info(),
        "running": _lock_info(),
        "config": _config_info(cfg),
        "schedule": store.read_schedule() if hasattr(store, "read_schedule") else None,
        "pending": pending,
        "outgoing": list({(p["account"], p["repo"], p["number"]): p for p in outgoing}.values()),
        "outgoingErrors": outgoing_errors,
        "issues": assigned,
        "issueErrors": issue_errors,
        "insightSettings": insights.settings(cfg),
        "selectionSettings": selection_settings,
        "outgoingFailedAccounts": outgoing_failed_accounts,
        "drafts": [{"repo": d.get("repo"), "number": d.get("number"),
                    "title": d.get("title"), "event": d.get("event"),
                    "inline": d.get("inline"), "demoted": d.get("demoted"),
                    "sha": d.get("sha"), "at": d.get("at")}
                   for d in store.pending_drafts()],
        "reviewed": state,
        "errors": errors,
    }


def cmd_status(args, cfg):
    if getattr(args, "json", False):
        print(json.dumps(status_payload(cfg, skip_details=getattr(args, "fast", False)),
                         ensure_ascii=False, indent=2))
        return 0
    groups = _accounts(cfg)
    for acct, repos in groups.items():
        if acct:
            try:
                me = gh.whoami(acct)
                mark = "✓" if (me or "").lower() == acct.lower() else "❌ 토큰 주인은 %s" % me
            except gh.GhError as e:
                mark = "❌ %s" % str(e)[:60]
            print("계정: %s %s → %s" % (acct, mark, ", ".join(sorted(repos))))
        else:
            print("계정: (전역 gh 활성 계정 %s) → %s"
                  % (gh.active_account() or "?", ", ".join(sorted(repos))))
    print("감시 저장소: %s" % (", ".join(cfg.get("repos") or {}) or "(없음 — 아무것도 리뷰하지 않습니다)"))
    print("게시 모드: %s" % ("dry-run (초안만)" if cfg["post"].get("dryRun", True) else "자동 게시"))
    print("일시정지: %s" % ("예" if store.is_paused() else "아니오"))
    state = store.load()
    prs = []
    for acct in groups:
        try:
            prs += [dict(p, account=acct or "global") for p in gh.review_requests(account=acct)]
        except gh.GhError as e:
            print("리뷰 요청 조회 실패 (%s): %s" % (acct or "전역 gh", e))
    known = set(cfg.get("repos") or {})
    print("\n대기 중인 리뷰 요청 %d건:" % len(prs))
    for p in prs:
        rec = state.get(store.key(p["repo"], p["number"]))
        hold = hold_reason(cfg, p) if p["repo"] in known and not rec else None
        if not rec:
            mark = ("◌ 보류" if hold else "· 대기") if p["repo"] in known else "  (감시 대상 아님)"
        elif rec.get("pending"):
            mark = "⏳ 검증 대기"
        elif rec.get('discarded'):
            mark = '정리됨'
        elif rec.get("posted") is False:
            # 초안만 있는 기록. 게시 모드에서는 다음 틱이 다시 리뷰해서 게시한다.
            mark = "◦ 초안만" if cfg["post"].get("dryRun", True) else "◦ 초안만 → 재리뷰"
        else:
            mark = "✓ 리뷰함"
        print("  %-10s %s#%-6s %s" % (mark, p["repo"], p["number"], p["title"][:52]))
        if hold:
            print("  %-10s   └ %s" % ("", hold))
    print("\n처리 이력 %d건" % len(state))
    return 0


# verify.md 의 confidence 루브릭과 같은 구간이어야 분포를 읽을 수 있다.
CONF_BUCKETS = ((0, 25), (26, 50), (51, 75), (76, 90), (91, 100))
FATES = ("inline", "body", "drop", "filtered", "rejected")


def cmd_verify_log(args, cfg):
    """반증이 매긴 confidence 가 실제로 무엇을 갈랐는지 본다.

    지금 봇은 confidence 로 아무것도 거르지 않는다 (verdict 만 본다). 이 표는
    "점수의 컷이 필요한가, 필요하면 몇 점인가" 를 감이 아니라 분포로 답하기
    위한 것이다.
    """
    rows = store.read_verify()
    if not rows:
        print("반증 기록이 없습니다 — 리뷰를 한 번 돌리면 쌓입니다.")
        return 0
    if getattr(args, "json", False):
        print(json.dumps(rows, ensure_ascii=False, indent=2))
        return 0

    print("반증 기록 %d건 (%s ~ %s)\n"
          % (len(rows), rows[0].get("at", "?")[:10], rows[-1].get("at", "?")[:10]))
    print("%-10s %s" % ("confidence", "".join("%-10s" % f for f in FATES)))
    for lo, hi in CONF_BUCKETS:
        sel = [r for r in rows if isinstance(r.get("confidence"), int)
               and lo <= r["confidence"] <= hi]
        if not sel:
            continue
        counts = ["%-10s" % sum(1 for r in sel if r.get("fate") == f) for f in FATES]
        print("%-10s %s (합 %d)" % ("%d-%d" % (lo, hi), "".join(counts), len(sel)))
    unscored = [r for r in rows if not isinstance(r.get("confidence"), int)]
    if unscored:
        print("\n점수 없음 %d건 (검증 실패 — 지적은 살렸습니다)" % len(unscored))

    print("\n판정별:")
    for v in ("TRUE_POSITIVE", "FALSE_POSITIVE"):
        sel = [r for r in rows if r.get("verdict") == v]
        if sel:
            cs = [r["confidence"] for r in sel if isinstance(r.get("confidence"), int)]
            rng = " · conf %d~%d" % (min(cs), max(cs)) if cs else ""
            print("  %-15s %d건%s" % (v, len(sel), rng))

    if getattr(args, "verbose", False):
        print("\n전체 기록:")
        for r in rows[-(args.limit):]:
            print("  [%s/%s → %s] %s:%s %s"
                  % (r.get("verdict", "?"), r.get("confidence", "?"),
                     r.get("fate", "?"), r.get("path"), r.get("line"),
                     (r.get("title") or "")[:50]))
    return 0


# 에이전트 정의에 반드시 있어야 하는 것. 봇은 역할 본문만 쓰므로 Role 이 비면
# 리뷰어가 무엇을 보는 사람인지 아무도 모르는 채로 돈다.
REQUIRED_SECTIONS = ("Role",)


def _agent_summary(name, model_cfg):
    meta, _ = agents_mod.load(name)
    raw = (meta.get("tools") or "").strip().strip("[]")
    return {"name": name,
            "runsAs": cfg_mod.model_for(model_cfg, name),
            "frontmatterModel": meta.get("model") or "",
            "tools": [t.strip() for t in raw.split(",") if t.strip()],
            "description": (meta.get("description") or "")[:100]}


BUNDLED_AGENTS = os.path.join(cfg_mod.ROOT, "agents")


def cmd_setup(args, cfg):
    """처음 한 번 돌리는 설치. 번들 리뷰어를 깔고 launchd 를 이 기계에 맞춘다.

    봇은 리뷰어 정의를 ~/.claude/agents/ 에서 읽는다. 저장소가 들고 온 정의를
    거기에 복사해 두지 않으면 새 기계에서는 리뷰어가 하나도 서지 않는다.
    """
    steps = []

    # 1) 번들 리뷰어 설치
    if os.path.isdir(BUNDLED_AGENTS):
        os.makedirs(agents_mod.AGENTS_DIR, exist_ok=True)
        for fn in sorted(os.listdir(BUNDLED_AGENTS)):
            if not fn.endswith(".md"):
                continue
            src = os.path.join(BUNDLED_AGENTS, fn)
            dest = os.path.join(agents_mod.AGENTS_DIR, fn)
            if os.path.exists(dest) and not args.force:
                same = _same_role(src, dest)
                steps.append("리뷰어 %s — 이미 있어 건너뜀%s" % (
                    fn[:-3], "" if same else
                    " · **봇이 읽는 내용이 번들과 다릅니다** (`agent diff` 로 확인)"))
                continue
            shutil.copyfile(src, dest)
            steps.append("리뷰어 %s → %s" % (fn[:-3], dest))

    # 2) config.json 이 없으면 예시에서 만든다
    cfg_path = args.config or os.path.join(cfg_mod.ROOT, "config.json")
    if not os.path.exists(cfg_path):
        example = os.path.join(cfg_mod.ROOT, "config.example.json")
        if os.path.exists(example):
            shutil.copyfile(example, cfg_path)
            steps.append("설정 %s (예시에서 복사 — repos 를 채우세요)" % cfg_path)

    # 3) launchd plist 를 이 기계의 경로로 찍어 낸다
    if args.launchd:
        steps.append(_write_plist(args.interval))

    for line in steps:
        print("  " + line)
    print()
    print("다음으로:")
    print("  review-bot repo add <owner/repo> --path <로컬 클론>")
    print("  review-bot account set <gh 계정>")
    print("  review-bot doctor")
    return 0


def _write_plist(interval_min):
    """launchd plist 를 지금 이 설치 위치로 만들어 넣는다."""
    root = cfg_mod.ROOT
    label = LAUNCHD_LABEL
    path = _plist_path()
    if os.path.islink(path):
        # 이미 저장소의 plist 로 링크가 걸려 있다. 덮어쓰면 그 링크가 끊긴다.
        return ("launchd %s — 이미 링크로 등록되어 있어 건드리지 않았습니다" % path)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    plist = {
        "Label": label,
        "ProgramArguments": [os.path.join(root, "review-bot"), "tick"],
        "WorkingDirectory": root,
        "StandardOutPath": os.path.join(root, "state", "bot.log"),
        "StandardErrorPath": os.path.join(root, "state", "bot.err"),
        "StartInterval": max(60, int(interval_min) * 60),
        "RunAtLoad": False,
        "EnvironmentVariables": {"PATH": os.environ.get(
            "PATH", "/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin")},
    }
    os.makedirs(os.path.join(root, "state"), exist_ok=True)
    with open(path, "wb") as f:
        plistlib.dump(plist, f)
    return ("launchd %s (%d분 간격) — 켜려면 `launchctl load %s`"
            % (path, interval_min, path))


def cmd_agent(args, cfg):
    """리뷰어 등록·해제·목록. 정의 파일은 ~/.claude/agents/ 에 산다."""
    raw = cfg_mod.load_raw(args.config)
    rcfg = raw.setdefault("review", {})
    listed = rcfg.get("agents")
    if listed is None:                    # 파일에 없으면 기본값이 돌고 있는 것이다
        listed = list(cfg["review"]["agents"])

    if args.action == "list":
        for name in listed:
            try:
                info = _agent_summary(name, cfg["review"].get("model"))
                print("%-24s %-8s 도구 %s" % (
                    info["name"], info["runsAs"], ",".join(info["tools"]) or "-"))
                if info["description"]:
                    print("  %s" % info["description"])
            except agents_mod.AgentError as e:
                print("%-24s ❌ %s" % (name, e))
        if not listed:
            print("등록된 리뷰어가 없습니다.")
        return 0

    if args.action == "add":
        src = os.path.expanduser(args.target)
        if not src.endswith(".md"):
            raise SystemExit("에이전트 정의는 .md 파일이어야 합니다: %s" % src)
        try:
            meta, body = agents_mod.parse(src)
        except agents_mod.AgentError as e:
            raise SystemExit(str(e))
        name = (args.name or meta.get("name") or
                os.path.basename(src)[:-3]).strip()
        if not name or "/" in name or name.startswith("."):
            raise SystemExit("에이전트 이름이 이상합니다: %r" % name)
        missing = [h for h in REQUIRED_SECTIONS
                   if ("# " + h) not in body]
        if missing:
            raise SystemExit("정의에 %s 섹션이 없습니다 — 봇은 그 본문으로 리뷰어를 세웁니다"
                             % ", ".join(missing))

        dest = os.path.join(agents_mod.AGENTS_DIR, name + ".md")
        if os.path.abspath(src) != os.path.abspath(dest):
            if os.path.exists(dest) and not args.force:
                raise SystemExit("이미 있습니다: %s — 덮어쓰려면 --force" % dest)
            os.makedirs(agents_mod.AGENTS_DIR, exist_ok=True)
            shutil.copyfile(src, dest)
            print("정의 복사 → %s" % dest)

        if name in listed:
            print("이미 등록된 리뷰어입니다: %s" % name)
        else:
            listed.append(name)
            rcfg["agents"] = listed
            cfg_mod.save_raw(raw, args.config)
            print("등록: %s (리뷰어 %d개)" % (name, len(listed)))
        if args.model:
            return _set_agent_model(raw, name, args.model, args.config)
        # 걷어내고 남는 것이 실제로 리뷰어에게 가는 본문이다 — 등록 직후에 보여 준다
        role = agents_mod.role(name)
        secs = [l[2:] for l in role.splitlines() if l.startswith("# ")]
        print("  봇이 쓰는 섹션: %s (%d자)" % (", ".join(secs) or "(없음)", len(role)))
        print("  실제 모델: %s · 도구: %s"
              % (cfg_mod.model_for(cfg["review"].get("model"), name),
                 reviewer.ALLOWED_TOOLS))
        return 0

    if args.action == "remove":
        name = args.target
        if name not in listed:
            raise SystemExit("등록되어 있지 않습니다: %s" % name)
        listed.remove(name)
        rcfg["agents"] = listed
        # 모델 지정도 같이 걷어낸다. 남겨 두면 없는 리뷰어의 설정이 쌓인다.
        m = rcfg.get("model")
        if isinstance(m, dict) and name in m:
            del m[name]
        cfg_mod.save_raw(raw, args.config)
        print("해제: %s (리뷰어 %d개) — 정의 파일은 그대로 둡니다" % (name, len(listed)))
        return 0

    if args.action == "export":
        # 설치본(~/.claude/agents/)을 저장소의 배포용 번들로 되돌려 넣는다.
        # 쓰면서 다듬은 정의가 배포판에만 낡은 채 남는 것을 막는 경로다.
        name = args.target
        src = os.path.join(agents_mod.AGENTS_DIR, name + ".md")
        if not os.path.exists(src):
            raise SystemExit("설치된 정의가 없습니다: %s" % src)
        os.makedirs(BUNDLED_AGENTS, exist_ok=True)
        dest = os.path.join(BUNDLED_AGENTS, name + ".md")
        if os.path.exists(dest) and _same_role(src, dest):
            print("이미 같습니다: %s" % dest)
            return 0
        shutil.copyfile(src, dest)
        print("번들에 반영: %s → %s" % (src, dest))
        print("  커밋해야 배포판에 실립니다")
        return 0

    if args.action == "diff":
        # 설치본과 번들이 갈렸는지
        names = [args.target] if args.target else sorted(
            f[:-3] for f in os.listdir(BUNDLED_AGENTS)
            if f.endswith(".md")) if os.path.isdir(BUNDLED_AGENTS) else []
        drift = 0
        for name in names:
            src = os.path.join(agents_mod.AGENTS_DIR, name + ".md")
            dest = os.path.join(BUNDLED_AGENTS, name + ".md")
            if not os.path.exists(dest):
                print("%-24s 번들에 없음 (배포판은 이 리뷰어를 들고 가지 않습니다)" % name)
            elif not os.path.exists(src):
                print("%-24s 설치본 없음 — `review-bot setup` 이 깝니다" % name)
            elif _same_role(src, dest):
                print("%-24s 같음 ✓" % name)
            else:
                print("%s — 봇이 읽는 내용이 다릅니다" % name)
                a, b = _role_map(src), _role_map(dest)
                for sec in sorted(set(a) | set(b)):
                    if sec not in b:
                        print("    %-16s 설치본에만 있음" % sec)
                    elif sec not in a:
                        print("    %-16s 번들에만 있음" % sec)
                    elif a[sec] != b[sec]:
                        print("    %-16s 내용이 다름 (설치본 %d자 · 번들 %d자)"
                              % (sec, len(a[sec]), len(b[sec])))
                print("    설치본을 번들로 옮기려면: review-bot agent export %s" % name)
                drift += 1
        if not names:
            print("번들에 리뷰어가 없습니다.")
        return 0

    if args.action == "model":
        if not args.target or not args.model:
            raise SystemExit("사용법: review-bot agent model <이름> --model <모델>")
        if args.target not in listed:
            raise SystemExit("등록되어 있지 않습니다: %s" % args.target)
        return _set_agent_model(raw, args.target, args.model, args.config)
    return 1


def _same_role(a, b):
    """봇이 실제로 읽는 부분이 같은가.

    파일 전체를 비교하면 대화형 세션용 섹션이 다르다는 이유로 늘 "다름" 이 뜬다.
    그것은 의도된 차이라 경고가 되면 신호가 죽는다. 봇 동작이 갈리는 차이만 센다.
    """
    try:
        return agents_mod.role_from(a) == agents_mod.role_from(b)
    except (agents_mod.AgentError, OSError):
        return False


def _role_map(path):
    """봇이 읽는 부분을 {섹션 이름: 내용} 으로. 어디가 갈렸는지 짚어 주려면
    파일 전체가 아니라 섹션 단위로 봐야 한다."""
    out, cur = {}, None
    try:
        text = agents_mod.role_from(path)
    except (agents_mod.AgentError, OSError):
        return {}
    for line in text.splitlines():
        if line.startswith("# "):
            cur = line[2:].strip()
            out[cur] = []
        elif cur:
            out[cur].append(line)
    return {k: "\n".join(v).strip() for k, v in out.items()}


def _set_agent_model(raw, name, model, path):
    """리뷰어 하나의 모델을 지정한다. 문자열 설정이면 dict 로 승격한다."""
    rcfg = raw.setdefault("review", {})
    m = rcfg.get("model")
    if not isinstance(m, dict):
        m = {"default": m or "sonnet"}
    m[name] = model
    rcfg["model"] = m
    cfg_mod.save_raw(raw, path)
    print("모델: %s → %s" % (name, model))
    return 0


