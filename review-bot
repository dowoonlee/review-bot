def cmd_forget(args, cfg):
    """이력에서 기록을 지운다.

    runs.jsonl 은 덧붙이기만 하는 파일이라 부분 삭제는 통째로 다시 쓰는 수밖에 없다.
    리뷰가 도는 중에 겹치면 그 사이 덧붙은 기록을 잃으므로 틱과 같은 lock 을 잡는다.
    """
    if not (args.target or args.all or args.older_than):
        print("무엇을 지울지 정하세요 — <owner/repo#123> 또는 --all 또는 --older-than <일>")
        return 1
    if not store.acquire_lock():
        _log("틱이 돌고 있습니다 — 끝난 뒤 다시 부르세요.")
        return 1
    try:
        rows = store.read_runs()
        before = len(rows)
        repo = number = None
        if args.target:
            repo, number = _parse_target(args.target)

        cutoff = None
        if args.older_than:
            cutoff = time.strftime(
                "%Y-%m-%dT%H:%M:%S",
                time.localtime(time.time() - float(args.older_than) * 86400))

        def doomed(r):
            if args.all:
                return True
            if repo is not None:
                if r.get("repo") != repo or r.get("number") != number:
                    return False
                if args.at and (r.get("at") or "") != args.at:
                    return False
                return cutoff is None or (r.get("at") or "") < cutoff
            return cutoff is not None and (r.get("at") or "") < cutoff

        keep = [r for r in rows if not doomed(r)]
        removed = before - len(keep)
        if removed:
            store.write_runs(keep)

        # 지문까지 지우면 그 PR 은 "본 적 없는 것" 이 되어 다음 틱에 다시 리뷰한다.
        forgotten = 0
        if args.reset:
            state = store.load()
            for key in list(state):
                if args.all or (repo is not None and key == store.key(repo, number)):
                    del state[key]
                    forgotten += 1
            if forgotten:
                store.save(state)

        print("이력 %d건 삭제 (남은 %d건)" % (removed, len(keep)))
        if forgotten:
            print("처리 지문 %d건도 지웠습니다 — 다음 틱에 다시 리뷰합니다 (비용 발생)"
                  % forgotten)
        return 0
    finally:
        store.release_lock()


def cmd_interval(args, cfg):
    """틱 주기 조회·변경. launchd plist 를 고치고 job 을 다시 올린다."""
    path = _plist_path()
    if not os.path.exists(path):
        print("launchd plist 이 없습니다: %s" % path)
        return 1
    real = os.path.realpath(path)                 # 심볼릭 링크면 원본을 고친다
    try:
        with open(real, "rb") as f:
            data = plistlib.load(f)
    except (OSError, ValueError, plistlib.InvalidFileException) as e:
        print("plist 를 읽지 못했습니다: %s" % e)
        return 1

    cur = data.get("StartInterval") or 0
    if args.minutes is None:
        print("%g분 (%d초)" % (cur / 60.0, cur))
        return 0

    secs = int(round(float(args.minutes) * 60))
    if secs < 60:
        print("최소 1분입니다 — 리뷰 한 건이 보통 15분 넘게 걸립니다")
        return 1
    if secs == cur:
        print("%g분 (그대로)" % (secs / 60.0))
        return 0

    # 다시 올리는 사이 job 이 잠깐 내려가므로, 도는 틱이 있으면 건드리지 않는다.
    lock = _lock_info()
    if lock and lock.get("alive"):
        print("틱이 돌고 있습니다 (pid %s) — 끝난 뒤 바꾸세요" % lock["pid"])
        return 1

    data["StartInterval"] = secs
    tmp = real + ".tmp"
    with open(tmp, "wb") as f:
        plistlib.dump(data, f)
    os.replace(tmp, real)

    uid = os.getuid()
    target = "gui/%d/%s" % (uid, LAUNCHD_LABEL)
    subprocess.run(["launchctl", "bootout", target],
                   capture_output=True, text=True, timeout=30)
    boot = subprocess.run(["launchctl", "bootstrap", "gui/%d" % uid, path],
                          capture_output=True, text=True, timeout=30)
    check = subprocess.run(["launchctl", "print", target],
                           capture_output=True, text=True, timeout=30)
    if check.returncode != 0:
        print("⚠️ job 을 다시 올리지 못했습니다 — 봇이 멈춘 상태입니다.")
        print("   %s" % (boot.stderr or boot.stdout or "").strip()[:200])
        print("   수동 복구: launchctl bootstrap gui/%d %s" % (uid, path))
        return 1
    # job 을 다시 올리면 launchd 의 주기 타이머도 처음부터 다시 센다.
    store.set_schedule_anchor("reload", secs)
    print("%g분 (%d초) — job 을 다시 올렸습니다" % (secs / 60.0, secs))
    return 0


def cmd_mode(args, cfg):
    """게시 모드 토글. 사람 검토를 거칠지 말지는 이 한 값이 정한다."""
    path = args.config or os.path.join(cfg_mod.ROOT, "config.json")
    if not args.mode:
        print("검토 후 게시 (초안만)" if cfg["post"].get("dryRun", True) else "자동 게시")
        return 0
    dry = (args.mode == "draft")
    raw = {}
    if os.path.exists(path):
        try:
            with open(path, encoding="utf-8") as f:
                raw = json.load(f)
        except (ValueError, OSError) as e:
            raise SystemExit("config.json 을 읽지 못했습니다: %s" % e)
    raw.setdefault("post", {})["dryRun"] = dry
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(raw, f, ensure_ascii=False, indent=2)
    os.replace(tmp, path)
    print("검토 후 게시 (초안만)" if dry else "자동 게시")
    return 0


def cmd_cap(args, cfg):
    """틱당 리뷰 상한 조회·변경.

    launchd 를 건드리지 않으므로 도는 틱이 있어도 안전하다. 틱은 시작할 때 설정을
    한 번 읽으므로, 바꾼 값은 다음 틱부터 적용된다.
    """
    path = args.config or os.path.join(cfg_mod.ROOT, "config.json")
    cur = cfg["limits"].get("maxPerTick") or 2
    if args.count is None:
        print("%d건" % cur)
        return 0
    n = args.count
    if n < 1:
        print("최소 1건입니다 — 아예 멈추려면 `review-bot pause` 를 쓰세요")
        return 1
    if n > 20:
        print("최대 20건입니다 — 한 건에 보통 10~20분, $2~9 가 듭니다")
        return 1
    if n == cur:
        print("%d건 (그대로)" % n)
        return 0
    raw = {}
    if os.path.exists(path):
        try:
            with open(path, encoding="utf-8") as f:
                raw = json.load(f)
        except (ValueError, OSError) as e:
            raise SystemExit("config.json 을 읽지 못했습니다: %s" % e)
    raw.setdefault("limits", {})["maxPerTick"] = n
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(raw, f, ensure_ascii=False, indent=2)
    os.replace(tmp, path)
    print("틱당 리뷰 상한 %d건 → %d건" % (cur, n))
    lock = _lock_info()
    if lock and lock.get("alive"):
        print("지금 도는 틱(pid %s)은 이전 상한으로 끝냅니다 — 다음 틱부터 적용됩니다"
              % lock["pid"])
    return 0


def cmd_tick(args, cfg):
    # launchd 가 띄운 틱만 타이머 기준점이 된다 — 손으로 부른 틱은 launchd 의 시계와
    # 무관하다. stdout 이 bot.log 로 리다이렉트돼 있으면 launchd 가 띄운 것이다.
    if _same_file_as_stdout(store.LOG_TEXT):
        store.set_schedule_anchor("launchd-tick", _interval_sec())
    if store.is_paused():
        _log("일시정지 상태입니다 (state/PAUSED). `review-bot resume` 으로 해제하세요.")
        return 0
    if not store.acquire_lock():
        _log("이전 틱이 아직 돌고 있습니다 — 건너뜁니다.")
        return 0
    try:
        return _tick(cfg)
    finally:
        store.release_lock()


def _gc(cfg, verbose=False):
    """부산물을 치운다. 틱마다 조용히 돌고, gc 커맨드로 직접 부를 수도 있다."""
    g = cfg.get("gc") or {}
    out = []
    swept = worktree.sweep(cfg.get("repos"))
    if swept:
        out.append("워크트리 %d개" % swept)
    ns, freed = janitor.sweep_sessions(g.get("sessionDays", 3))
    if ns:
        out.append("claude 세션 %d개 (%s)" % (ns, janitor.human(freed)))
    nd = janitor.prune_drafts(g.get("draftDays", 14))
    if nd:
        out.append("초안 %d개" % nd)
    nt = janitor.trim_runs(store.LOG, g.get("runsMaxLines", 2000))
    if nt:
        out.append("이력 %d줄" % nt)
    nv = janitor.trim_runs(store.VERIFY_LOG, g.get("verifyMaxLines", 20000))
    if nv:
        out.append("반증 기록 %d줄" % nv)
    if janitor.rotate_logs(g.get("logMaxBytes", 5000000)):
        out.append("로그 로테이션")
    nl, lfreed = janitor.prune_day_logs(g.get("logDays", 30))
    if nl:
        out.append("지난 로그 %d일치 (%s)" % (nl, janitor.human(lfreed)))
    nc, cfreed = janitor.sweep_cache_repos(cfg.get("repos"))
    if nc:
        out.append("캐시 클론 %d개 (%s)" % (nc, janitor.human(cfreed)))
    state = store.load()
    npr = janitor.prune_reviewed(state, g.get("reviewedDays", 90))
    if npr:
        store.save(state)
        out.append("오래된 기록 %d건" % npr)
    if out and (verbose or swept):
        _log("정리: " + " · ".join(out))
    elif verbose:
        _log("정리할 것 없음")
    return out


def cmd_gc(args, cfg):
    _gc(cfg, verbose=True)
    return 0


def _accounts(cfg):
    """계정 → 그 계정으로 다루는 저장소 집합. None 은 전역 활성 gh 를 뜻한다."""
    groups = {}
    for repo, entry in (cfg.get("repos") or {}).items():
        if (entry or {}).get("enabled") is False:
            continue
        acct = (entry or {}).get("account") or cfg.get("account")
        groups.setdefault(acct, set()).add(repo)
    return groups


def _tick(cfg):
    _gc(cfg)
    state = store.load()

    # 계정마다 따로 조회한다. 리뷰 요청은 @me 기준이라 계정이 다르면 목록이 다르다.
    targets, total = [], 0
    for acct, repos in _accounts(cfg).items():
        try:
            if acct:
                me = gh.whoami(acct)
                if (me or "").lower() != acct.lower():
                    _log("계정 %s 의 토큰 주인이 %s 입니다 — 이 계정의 저장소는 건너뜁니다"
                         % (acct, me or "?"))
                    continue
            prs = gh.review_requests(account=acct)
        except gh.GhError as e:
            _log("리뷰 요청 조회 실패 (%s): %s" % (acct or "전역 gh", e))
            continue
        total += len(prs)
        targets += [p for p in prs if p["repo"] in repos]
    _log("리뷰 요청 %d건 (감시 대상 %d건)" % (total, len(targets)))

    cap = cfg["limits"].get("maxPerTick") or 2
    done, reviewed = [], 0

    for pr in targets:
        if reviewed >= cap:
            _log("틱당 상한 %d건 도달 — 나머지는 다음 틱에" % cap)
            break
        _log("· %s#%s %s" % (pr["repo"], pr["number"], pr["title"][:50]))
        try:
            r = process_pr(pr, cfg, state)
        except (gh.GhError, worktree.WorktreeError, reviewer.ReviewError) as e:
            _log("  실패: %s" % str(e)[:200])
            store.log_run({"repo": pr["repo"], "number": pr["number"],
                           "error": str(e)[:300]})
            continue
        if r.get("skipped"):
            _log("  건너뜀 — %s" % r["skipped"])
            continue
        reviewed += 1
        done.append(r)
        store.mark(state, r["repo"], r["number"], r["sha"],
                   inline=r.get("inline"), demoted=r.get("demoted"),
                   posted=r.get("posted"), cost_usd=r.get("cost_usd"),
                   event=r.get("event"))
        store.save(state)
        store.log_run(r)
        where = "초안" if r.get("draft") else ("게시" if r.get("posted") else "-")
        _log("  %s — %s · inline %d · 요약 %d"
             % (where, EVENT_LABEL.get(r.get("event"), r.get("event") or "-"),
                r.get("inline") or 0, r.get("demoted") or 0))

    if done and cfg["notify"].get("enabled", True):
        head = done[0]
        title = "리뷰 %d건 %s" % (len(done), "초안" if head.get("draft") else "게시")
        msg = "; ".join("%s#%s → %d건" % (d["repo"].split("/")[-1], d["number"],
                                          (d.get("inline") or 0) + (d.get("demoted") or 0))
                        for d in done)
        notify.send("review-bot · " + title, msg,
                    sound=cfg["notify"].get("sound"), enabled=True)
    if not done:
        _log("새로 리뷰할 PR 없음")
    return 0


def _parse_target(s):
    s = s.strip()
    if "/pull/" in s:
        parts = s.split("/")
        i = parts.index("pull")
        return "%s/%s" % (parts[i - 2], parts[i - 1]), int(parts[i + 1])
    if "#" in s:
        repo, num = s.split("#", 1)
        return repo, int(num)
    raise SystemExit("PR 을 owner/repo#123 또는 PR URL 로 지정하세요")


def _narrow(cfg, agent_csv, note):
    """이번 실행에만 적용할 설정 — 리뷰어를 좁히고, 본문에 실을 안내를 단다."""
    out = cfg
    if agent_csv:
        names = [a.strip() for a in agent_csv.split(",") if a.strip()]
        for name in names:
            try:
                agents_mod.load(name)
            except agents_mod.AgentError as e:
                raise SystemExit(str(e))
        out = dict(out, review=dict(out["review"], agents=names))
    if note:
        out = dict(out, post=dict(out["post"], note=note))
    return out


def cmd_review(args, cfg):
    """PR 하나를 지금 리뷰한다. 이미 리뷰한 커밋이어도 강제로 다시 본다.

    틱과 같은 lock 을 잡는다. 겹치면 sweep 이 틱이 쓰고 있는 워크트리를 지워
    버리고, 같은 PR 을 둘이 리뷰해 같은 지적을 두 번 게시하기 때문이다.
    일시정지(PAUSED)는 보지 않는다 — 손으로 부르는 명령은 사람의 의도다.
    """
    repo, number = _parse_target(args.target)
    cfg = _narrow(cfg, getattr(args, "agents", None), getattr(args, "note", None))
    if not store.acquire_lock():
        _log("틱이 돌고 있습니다 — 끝난 뒤 다시 부르거나 `review-bot pause` 로 멈추세요.")
        return 1
    try:
        worktree.sweep(cfg.get("repos"))
        state = store.load()
        pr = {"repo": repo, "number": number, "title": ""}
        try:
            r = process_pr(pr, cfg, state, force=True)
        except (gh.GhError, worktree.WorktreeError, reviewer.ReviewError) as e:
            _log("실패: %s" % str(e)[:300])
            store.log_run({"repo": repo, "number": number, "error": str(e)[:300]})
            return 1
        if r.get("skipped"):
            _log("건너뜀 — %s" % r["skipped"])
            return 0
        store.mark(state, repo, number, r["sha"], inline=r.get("inline"),
                   demoted=r.get("demoted"), posted=r.get("posted"),
                   cost_usd=r.get("cost_usd"), event=r.get("event"))
        store.save(state)
        store.log_run(r)
        print(json.dumps(r, ensure_ascii=False, indent=2))
        return 0
    finally:
        store.release_lock()


LAUNCHD_LABEL = "com.review-bot.agent"


def _plist_path():
    return os.path.expanduser("~/Library/LaunchAgents/%s.plist" % LAUNCHD_LABEL)


def _interval_sec():
    """틱 주기. launchd plist 가 유일한 사실이다."""
    try:
        with open(_plist_path(), "rb") as f:
            return plistlib.load(f).get("StartInterval")
    except (OSError, ValueError, plistlib.InvalidFileException):
        return None


def _agent_info(names, model_cfg=None):
    """설정된 리뷰어들이 실제로 어떤 정의를 물고 있는지.

    frontmatter 의 model 과 tools 는 참고용이다 — 봇은 모델을 config 로 덮고
    도구는 reviewer.ALLOWED_TOOLS 로 고정한다. 둘 다 보여 줘야 오해가 없다.
    `runsAs` 가 그 리뷰어가 실제로 도는 모델이다.
    """
    out = []
    for name in names:
        info = {"name": name, "exists": False, "tools": [], "description": "",
                "model": "", "runsAs": cfg_mod.model_for(model_cfg, name),
                "role": ""}
        try:
            meta, body = agents_mod.load(name)
            info["exists"] = True
            info["description"] = meta.get("description") or ""
            info["model"] = meta.get("model") or ""
            raw = (meta.get("tools") or "").strip().strip("[]")
            info["tools"] = [t.strip() for t in raw.split(",") if t.strip()]
            lines = [l for l in body.splitlines() if l.strip() and not l.startswith("#")]
            info["role"] = "\n".join(lines[:5])[:400]
            info["path"] = os.path.join(agents_mod.AGENTS_DIR, name + ".md")
        except agents_mod.AgentError as e:
            info["error"] = str(e)
        out.append(info)
    return out


def _model_summary(m):
    """에이전트별 dict 를 한 줄로 접는다.

    status 는 사람이 읽는 화면이고, 이 값을 읽는 설정 앱도 문자열을 기대한다.
    구조화된 원본이 필요하면 `modelByAgent` 를 본다.
    """
    if not isinstance(m, dict):
        return m or "opus"
    rest = ["%s: %s" % (k, v) for k, v in sorted(m.items()) if k != "default"]
    base = m.get("default") or "opus"
    return "%s (%s)" % (base, ", ".join(rest)) if rest else base


def _config_info(cfg):
    rcfg, pcfg = cfg["review"], cfg["post"]
    return {
        "account": cfg.get("account"),
        "model": _model_summary(rcfg.get("model")),
        "modelByAgent": rcfg.get("model") if isinstance(rcfg.get("model"), dict) else None,
        "judgeModel": pcfg.get("judgeModel"),
        "parallel": bool(rcfg.get("parallel", True)),
        "maxTurns": rcfg.get("maxTurns"),
        "timeoutSec": rcfg.get("timeoutSec"),
        "maxChangedFiles": rcfg.get("maxChangedFiles"),
        "maxDiffLines": rcfg.get("maxDiffLines"),
        "minSeverity": pcfg.get("minSeverity"),
        "maxFindingsPerPR": pcfg.get("maxFindingsPerPR"),
        "allowedEvents": pcfg.get("allowedEvents") or [],
        "autonomous": bool(pcfg.get("autonomous", True)),
        "maxPerTick": cfg["limits"].get("maxPerTick"),
        "intervalSec": _interval_sec(),
        # 봇이 리뷰어에게 실제로 주는 도구. 에이전트 정의의 tools 보다 이쪽이 세다.
        "botTools": [t for t in (reviewer.ALLOWED_TOOLS or "").split(",") if t],
        "agents": _agent_info(rcfg.get("agents") or [], rcfg.get("model")),
    }


def _lock_info():
    """지금 틱이 돌고 있는가. lock 파일의 주인이 살아 있어야 진짜다."""
    if not os.path.exists(store.LOCK):
        return None
    try:
        with open(store.LOCK, encoding="utf-8") as f:
            parts = (f.read() or "").split()
        pid = int(parts[0])
        since = parts[1] if len(parts) > 1 else ""
    except (ValueError, OSError, IndexError):
        return None
    try:
        os.kill(pid, 0)
    except OSError:
        return {"pid": pid, "since": since, "alive": False}
    return {"pid": pid, "since": since, "alive": True}


def _paused_info():
    if not store.is_paused():
        return None
    try:
        with open(store.PAUSED, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError:
        lines = []
    return {"at": (lines[0] if lines else ""), "reason": (lines[1] if len(lines) > 1 else "")}


def status_payload(cfg, skip_details=False):
    """앱·스크립트가 읽는 상태 스냅샷. 사람이 읽는 cmd_status 와 같은 사실을 낸다.

    토큰이 필요한 조회는 전부 여기(봇 프로세스) 안에서 끝난다 — 호출하는 쪽은
    키체인도 gh 계정도 알 필요가 없다.
    """
    groups = _accounts(cfg)
    state = store.load()
    accounts, errors, prs = [], [], []
    outgoing, outgoing_errors, outgoing_failed_accounts = [], [], []
    for acct, repos in groups.items():
        info = {"account": acct, "repos": sorted(repos), "tokenOwner": None, "ok": False}
        try:
            me = gh.whoami(acct) if acct else (gh.active_account() or "")
            info["tokenOwner"] = me
            info["ok"] = (not acct) or ((me or "").lower() == (acct or "").lower())
        except gh.GhError as e:
            info["error"] = str(e)[:200]
        accounts.append(info)
        try:
            prs += gh.review_requests(account=acct)
        except gh.GhError as e:
            errors.append("리뷰 요청 조회 실패 (%s): %s" % (acct or "전역 gh", str(e)[:200]))
        try:
            sent, warnings = gh.sent_review_requests(account=acct)
            outgoing.extend(sent)
            outgoing_errors.extend(warnings)
        except gh.GhError as e:
            outgoing_failed_accounts.append(acct or "global")
            outgoing_errors.append("보낸 요청 조회 실패 (%s): %s" % (acct or "전역 gh", str(e)[:200]))
    known = set(cfg.get("repos") or {})
    pending = []
    for p in prs:
        rec = state.get(store.key(p["repo"], p["number"])) or {}
        if p["repo"] not in known:
            st = "unwatched"
        elif not rec:
            st = "new"
        elif rec.get("posted") is False:
            st = "draft"
        else:
            st = "posted"
        item = dict(p, watched=p["repo"] in known, status=st,
                    event=rec.get("event"), lastSha=rec.get("sha"))
        if p["repo"] in known and not skip_details:
            acct = (cfg_mod.repo_entry(cfg, p["repo"]) or {}).get("account") or cfg.get("account")
            try:
                me = gh.whoami(acct) if acct else (gh.active_account() or "")
                item["requestedBy"] = gh.review_requester(p["repo"], p["number"], me,
                                                          account=acct)
            except gh.GhError:
                item["requestedBy"] = None
            try:
                meta = gh.pr_meta(p["repo"], p["number"], account=acct)
                item["issues"] = gh.linked_issues(p["repo"], p["number"],
                                                  meta.get("title") or p["title"],
                                                  meta.get("body") or "", account=acct)
                item["prAuthor"] = (meta.get("author") or {}).get("login") or p["author"]
                item["isDraft"] = bool(meta.get("isDraft"))
                item["changedFiles"] = meta.get("changedFiles")
            except gh.GhError:
                item["issues"] = []
        pending.append(item)
    return {
        "at": time.strftime("%Y-%m-%dT%H:%M:%S"),
        "accounts": accounts,
        "repos": sorted(cfg.get("repos") or {}),
        # UI 가 편집하려면 이름만으로는 부족하다 — 켜짐 여부와 로컬 클론까지 준다.
        "repoDetails": [
            {"slug": name,
             "enabled": bool(e.get("enabled", True)),
             "account": e.get("account") or "",
             "localPath": e.get("localPath") or "",
             "cloned": os.path.isdir(os.path.join(
                 os.path.expanduser(e.get("localPath") or "/nonexistent"), ".git"))}
            for name, e in sorted((cfg.get("repos") or {}).items())],
        "dryRun": bool(cfg["post"].get("dryRun", True)),
        "maxPerTick": cfg["limits"].get("maxPerTick") or 2,
        "paused": _paused_info(),
        "running": _lock_info(),
        "config": _config_info(cfg),
        "schedule": store.read_schedule() if hasattr(store, "read_schedule") else None,
        "pending": pending,
        "outgoing": list({(p["account"], p["repo"], p["number"]): p for p in outgoing}.values()),
        "outgoingErrors": outgoing_errors,
        "outgoingFailedAccounts": outgoing_failed_accounts,
        "drafts": [{"repo": d.get("repo"), "number": d.get("number"),
                    "title": d.get("title"), "event": d.get("event"),
                    "inline": d.get("inline"), "demoted": d.get("demoted"),
                    "sha": d.get("sha"), "at": d.get("at")}
                   for d in store.pending_drafts()],
        "reviewed": state,
        "errors": errors,
    }


def cmd_status(args, cfg):
    if getattr(args, "json", False):
        print(json.dumps(status_payload(cfg, skip_details=getattr(args, "fast", False)),
                         ensure_ascii=False, indent=2))
        return 0
    groups = _accounts(cfg)
    for acct, repos in groups.items():
        if acct:
            try:
                me = gh.whoami(acct)
                mark = "✓" if (me or "").lower() == acct.lower() else "❌ 토큰 주인은 %s" % me
            except gh.GhError as e:
                mark = "❌ %s" % str(e)[:60]
            print("계정: %s %s → %s" % (acct, mark, ", ".join(sorted(repos))))
        else:
            print("계정: (전역 gh 활성 계정 %s) → %s"
                  % (gh.active_account() or "?", ", ".join(sorted(repos))))
    print("감시 저장소: %s" % (", ".join(cfg.get("repos") or {}) or "(없음 — 아무것도 리뷰하지 않습니다)"))
    print("게시 모드: %s" % ("dry-run (초안만)" if cfg["post"].get("dryRun", True) else "자동 게시"))
    print("일시정지: %s" % ("예" if store.is_paused() else "아니오"))
    state = store.load()
    prs = []
    for acct in groups:
        try:
            prs += gh.review_requests(account=acct)
        except gh.GhError as e:
            print("리뷰 요청 조회 실패 (%s): %s" % (acct or "전역 gh", e))
    known = set(cfg.get("repos") or {})
    print("\n대기 중인 리뷰 요청 %d건:" % len(prs))
    for p in prs:
        rec = state.get(store.key(p["repo"], p["number"]))
        if not rec:
            mark = "· 대기" if p["repo"] in known else "  (감시 대상 아님)"
        elif rec.get("posted") is False:
            # 초안만 있는 기록. 게시 모드에서는 다음 틱이 다시 리뷰해서 게시한다.
            mark = "◦ 초안만" if cfg["post"].get("dryRun", True) else "◦ 초안만 → 재리뷰"
        else:
            mark = "✓ 리뷰함"
        print("  %-10s %s#%-6s %s" % (mark, p["repo"], p["number"], p["title"][:52]))
    print("\n처리 이력 %d건" % len(state))
    return 0


# verify.md 의 confidence 루브릭과 같은 구간이어야 분포를 읽을 수 있다.
CONF_BUCKETS = ((0, 25), (26, 50), (51, 75), (76, 90), (91, 100))
FATES = ("inline", "body", "drop", "filtered", "rejected")


def cmd_verify_log(args, cfg):
    """반증이 매긴 confidence 가 실제로 무엇을 갈랐는지 본다.

    지금 봇은 confidence 로 아무것도 거르지 않는다 (verdict 만 본다). 이 표는
    "점수의 컷이 필요한가, 필요하면 몇 점인가" 를 감이 아니라 분포로 답하기
    위한 것이다.
    """
    rows = store.read_verify()
    if not rows:
        print("반증 기록이 없습니다 — 리뷰를 한 번 돌리면 쌓입니다.")
        return 0
    if getattr(args, "json", False):
        print(json.dumps(rows, ensure_ascii=False, indent=2))
        return 0

    print("반증 기록 %d건 (%s ~ %s)\n"
          % (len(rows), rows[0].get("at", "?")[:10], rows[-1].get("at", "?")[:10]))
    print("%-10s %s" % ("confidence", "".join("%-10s" % f for f in FATES)))
    for lo, hi in CONF_BUCKETS:
        sel = [r for r in rows if isinstance(r.get("confidence"), int)
               and lo <= r["confidence"] <= hi]
        if not sel:
            continue
        counts = ["%-10s" % sum(1 for r in sel if r.get("fate") == f) for f in FATES]
        print("%-10s %s (합 %d)" % ("%d-%d" % (lo, hi), "".join(counts), len(sel)))
    unscored = [r for r in rows if not isinstance(r.get("confidence"), int)]
    if unscored:
        print("\n점수 없음 %d건 (검증 실패 — 지적은 살렸습니다)" % len(unscored))

    print("\n판정별:")
    for v in ("TRUE_POSITIVE", "FALSE_POSITIVE"):
        sel = [r for r in rows if r.get("verdict") == v]
        if sel:
            cs = [r["confidence"] for r in sel if isinstance(r.get("confidence"), int)]
            rng = " · conf %d~%d" % (min(cs), max(cs)) if cs else ""
            print("  %-15s %d건%s" % (v, len(sel), rng))

    if getattr(args, "verbose", False):
        print("\n전체 기록:")
        for r in rows[-(args.limit):]:
            print("  [%s/%s → %s] %s:%s %s"
                  % (r.get("verdict", "?"), r.get("confidence", "?"),
                     r.get("fate", "?"), r.get("path"), r.get("line"),
                     (r.get("title") or "")[:50]))
    return 0


# 에이전트 정의에 반드시 있어야 하는 것. 봇은 역할 본문만 쓰므로 Role 이 비면
# 리뷰어가 무엇을 보는 사람인지 아무도 모르는 채로 돈다.
REQUIRED_SECTIONS = ("Role",)


def _agent_summary(name, model_cfg):
    meta, _ = agents_mod.load(name)
    raw = (meta.get("tools") or "").strip().strip("[]")
    return {"name": name,
            "runsAs": cfg_mod.model_for(model_cfg, name),
            "frontmatterModel": meta.get("model") or "",
            "tools": [t.strip() for t in raw.split(",") if t.strip()],
            "description": (meta.get("description") or "")[:100]}


BUNDLED_AGENTS = os.path.join(cfg_mod.ROOT, "agents")


def cmd_setup(args, cfg):
    """처음 한 번 돌리는 설치. 번들 리뷰어를 깔고 launchd 를 이 기계에 맞춘다.

    봇은 리뷰어 정의를 ~/.claude/agents/ 에서 읽는다. 저장소가 들고 온 정의를
    거기에 복사해 두지 않으면 새 기계에서는 리뷰어가 하나도 서지 않는다.
    """
    steps = []

    # 1) 번들 리뷰어 설치
    if os.path.isdir(BUNDLED_AGENTS):
        os.makedirs(agents_mod.AGENTS_DIR, exist_ok=True)
        for fn in sorted(os.listdir(BUNDLED_AGENTS)):
            if not fn.endswith(".md"):
                continue
            src = os.path.join(BUNDLED_AGENTS, fn)
            dest = os.path.join(agents_mod.AGENTS_DIR, fn)
            if os.path.exists(dest) and not args.force:
                same = _same_role(src, dest)
                steps.append("리뷰어 %s — 이미 있어 건너뜀%s" % (
                    fn[:-3], "" if same else
                    " · **봇이 읽는 내용이 번들과 다릅니다** (`agent diff` 로 확인)"))
                continue
            shutil.copyfile(src, dest)
            steps.append("리뷰어 %s → %s" % (fn[:-3], dest))

    # 2) config.json 이 없으면 예시에서 만든다
    cfg_path = args.config or os.path.join(cfg_mod.ROOT, "config.json")
    if not os.path.exists(cfg_path):
        example = os.path.join(cfg_mod.ROOT, "config.example.json")
        if os.path.exists(example):
            shutil.copyfile(example, cfg_path)
            steps.append("설정 %s (예시에서 복사 — repos 를 채우세요)" % cfg_path)

    # 3) launchd plist 를 이 기계의 경로로 찍어 낸다
    if args.launchd:
        steps.append(_write_plist(args.interval))

    for line in steps:
        print("  " + line)
    print()
    print("다음으로:")
    print("  review-bot repo add <owner/repo> --path <로컬 클론>")
    print("  review-bot account set <gh 계정>")
    print("  review-bot doctor")
    return 0


def _write_plist(interval_min):
    """launchd plist 를 지금 이 설치 위치로 만들어 넣는다."""
    root = cfg_mod.ROOT
    label = LAUNCHD_LABEL
    path = _plist_path()
    if os.path.islink(path):
        # 이미 저장소의 plist 로 링크가 걸려 있다. 덮어쓰면 그 링크가 끊긴다.
        return ("launchd %s — 이미 링크로 등록되어 있어 건드리지 않았습니다" % path)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    plist = {
        "Label": label,
        "ProgramArguments": [os.path.join(root, "review-bot"), "tick"],
        "WorkingDirectory": root,
        "StandardOutPath": os.path.join(root, "state", "bot.log"),
        "StandardErrorPath": os.path.join(root, "state", "bot.err"),
        "StartInterval": max(60, int(interval_min) * 60),
        "RunAtLoad": False,
        "EnvironmentVariables": {"PATH": os.environ.get(
            "PATH", "/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin")},
    }
    os.makedirs(os.path.join(root, "state"), exist_ok=True)
    with open(path, "wb") as f:
        plistlib.dump(plist, f)
    return ("launchd %s (%d분 간격) — 켜려면 `launchctl load %s`"
            % (path, interval_min, path))


def cmd_agent(args, cfg):
    """리뷰어 등록·해제·목록. 정의 파일은 ~/.claude/agents/ 에 산다."""
    raw = cfg_mod.load_raw(args.config)
    rcfg = raw.setdefault("review", {})
    listed = rcfg.get("agents")
    if listed is None:                    # 파일에 없으면 기본값이 돌고 있는 것이다
        listed = list(cfg["review"]["agents"])

    if args.action == "list":
        for name in listed:
            try:
                info = _agent_summary(name, cfg["review"].get("model"))
                print("%-24s %-8s 도구 %s" % (
                    info["name"], info["runsAs"], ",".join(info["tools"]) or "-"))
                if info["description"]:
                    print("  %s" % info["description"])
            except agents_mod.AgentError as e:
                print("%-24s ❌ %s" % (name, e))
        if not listed:
            print("등록된 리뷰어가 없습니다.")
        return 0

    if args.action == "add":
        src = os.path.expanduser(args.target)
        if not src.endswith(".md"):
            raise SystemExit("에이전트 정의는 .md 파일이어야 합니다: %s" % src)
        try:
            meta, body = agents_mod.parse(src)
        except agents_mod.AgentError as e:
            raise SystemExit(str(e))
        name = (args.name or meta.get("name") or
                os.path.basename(src)[:-3]).strip()
        if not name or "/" in name or name.startswith("."):
            raise SystemExit("에이전트 이름이 이상합니다: %r" % name)
        missing = [h for h in REQUIRED_SECTIONS
                   if ("# " + h) not in body]
        if missing:
            raise SystemExit("정의에 %s 섹션이 없습니다 — 봇은 그 본문으로 리뷰어를 세웁니다"
                             % ", ".join(missing))

        dest = os.path.join(agents_mod.AGENTS_DIR, name + ".md")
        if os.path.abspath(src) != os.path.abspath(dest):
            if os.path.exists(dest) and not args.force:
                raise SystemExit("이미 있습니다: %s — 덮어쓰려면 --force" % dest)
            os.makedirs(agents_mod.AGENTS_DIR, exist_ok=True)
            shutil.copyfile(src, dest)
            print("정의 복사 → %s" % dest)

        if name in listed:
            print("이미 등록된 리뷰어입니다: %s" % name)
        else:
            listed.append(name)
            rcfg["agents"] = listed
            cfg_mod.save_raw(raw, args.config)
            print("등록: %s (리뷰어 %d개)" % (name, len(listed)))
        if args.model:
            return _set_agent_model(raw, name, args.model, args.config)
        # 걷어내고 남는 것이 실제로 리뷰어에게 가는 본문이다 — 등록 직후에 보여 준다
        role = agents_mod.role(name)
        secs = [l[2:] for l in role.splitlines() if l.startswith("# ")]
        print("  봇이 쓰는 섹션: %s (%d자)" % (", ".join(secs) or "(없음)", len(role)))
        print("  실제 모델: %s · 도구: %s"
              % (cfg_mod.model_for(cfg["review"].get("model"), name),
                 reviewer.ALLOWED_TOOLS))
        return 0

    if args.action == "remove":
        name = args.target
        if name not in listed:
            raise SystemExit("등록되어 있지 않습니다: %s" % name)
        listed.remove(name)
        rcfg["agents"] = listed
        # 모델 지정도 같이 걷어낸다. 남겨 두면 없는 리뷰어의 설정이 쌓인다.
        m = rcfg.get("model")
        if isinstance(m, dict) and name in m:
            del m[name]
        cfg_mod.save_raw(raw, args.config)
        print("해제: %s (리뷰어 %d개) — 정의 파일은 그대로 둡니다" % (name, len(listed)))
        return 0

    if args.action == "export":
        # 설치본(~/.claude/agents/)을 저장소의 배포용 번들로 되돌려 넣는다.
        # 쓰면서 다듬은 정의가 배포판에만 낡은 채 남는 것을 막는 경로다.
        name = args.target
        src = os.path.join(agents_mod.AGENTS_DIR, name + ".md")
        if not os.path.exists(src):
            raise SystemExit("설치된 정의가 없습니다: %s" % src)
        os.makedirs(BUNDLED_AGENTS, exist_ok=True)
        dest = os.path.join(BUNDLED_AGENTS, name + ".md")
        if os.path.exists(dest) and _same_role(src, dest):
            print("이미 같습니다: %s" % dest)
            return 0
        shutil.copyfile(src, dest)
        print("번들에 반영: %s → %s" % (src, dest))
        print("  커밋해야 배포판에 실립니다")
        return 0

    if args.action == "diff":
        # 설치본과 번들이 갈렸는지
        names = [args.target] if args.target else sorted(
            f[:-3] for f in os.listdir(BUNDLED_AGENTS)
            if f.endswith(".md")) if os.path.isdir(BUNDLED_AGENTS) else []
        drift = 0
        for name in names:
            src = os.path.join(agents_mod.AGENTS_DIR, name + ".md")
            dest = os.path.join(BUNDLED_AGENTS, name + ".md")
            if not os.path.exists(dest):
                print("%-24s 번들에 없음 (배포판은 이 리뷰어를 들고 가지 않습니다)" % name)
            elif not os.path.exists(src):
                print("%-24s 설치본 없음 — `review-bot setup` 이 깝니다" % name)
            elif _same_role(src, dest):
                print("%-24s 같음 ✓" % name)
            else:
                print("%s — 봇이 읽는 내용이 다릅니다" % name)
                a, b = _role_map(src), _role_map(dest)
                for sec in sorted(set(a) | set(b)):
                    if sec not in b:
                        print("    %-16s 설치본에만 있음" % sec)
                    elif sec not in a:
                        print("    %-16s 번들에만 있음" % sec)
                    elif a[sec] != b[sec]:
                        print("    %-16s 내용이 다름 (설치본 %d자 · 번들 %d자)"
                              % (sec, len(a[sec]), len(b[sec])))
                print("    설치본을 번들로 옮기려면: review-bot agent export %s" % name)
                drift += 1
        if not names:
            print("번들에 리뷰어가 없습니다.")
        return 0

    if args.action == "model":
        if not args.target or not args.model:
            raise SystemExit("사용법: review-bot agent model <이름> --model <모델>")
        if args.target not in listed:
            raise SystemExit("등록되어 있지 않습니다: %s" % args.target)
        return _set_agent_model(raw, args.target, args.model, args.config)
    return 1


def _same_role(a, b):
    """봇이 실제로 읽는 부분이 같은가.

    파일 전체를 비교하면 대화형 세션용 섹션이 다르다는 이유로 늘 "다름" 이 뜬다.
    그것은 의도된 차이라 경고가 되면 신호가 죽는다. 봇 동작이 갈리는 차이만 센다.
    """
    try:
        return agents_mod.role_from(a) == agents_mod.role_from(b)
    except (agents_mod.AgentError, OSError):
        return False


def _role_map(path):
    """봇이 읽는 부분을 {섹션 이름: 내용} 으로. 어디가 갈렸는지 짚어 주려면
    파일 전체가 아니라 섹션 단위로 봐야 한다."""
    out, cur = {}, None
    try:
        text = agents_mod.role_from(path)
    except (agents_mod.AgentError, OSError):
        return {}
    for line in text.splitlines():
        if line.startswith("# "):
            cur = line[2:].strip()
            out[cur] = []
        elif cur:
            out[cur].append(line)
    return {k: "\n".join(v).strip() for k, v in out.items()}


def _set_agent_model(raw, name, model, path):
    """리뷰어 하나의 모델을 지정한다. 문자열 설정이면 dict 로 승격한다."""
    rcfg = raw.setdefault("review", {})
    m = rcfg.get("model")
    if not isinstance(m, dict):
        m = {"default": m or "sonnet"}
    m[name] = model
    rcfg["model"] = m
    cfg_mod.save_raw(raw, path)
    print("모델: %s → %s" % (name, model))
    return 0


def cmd_repo(args, cfg):
    """감시할 저장소 등록·해제·목록. 화이트리스트가 곧 안전장치다."""
    raw = cfg_mod.load_raw(args.config)
    repos = raw.setdefault("repos", {})

    if args.action == "list":
        if not repos:
            print("감시 저장소가 없습니다 — 아무 PR 도 리뷰하지 않습니다.")
        for name, e in sorted(repos.items()):
            lp = os.path.expanduser(e.get("localPath") or "")
            mark = "" if not lp else (" · 클론 있음" if os.path.isdir(os.path.join(lp, ".git"))
                                      else " · ❌ 클론 없음: %s" % lp)
            print("%-30s %s%s%s" % (
                name, "켜짐" if e.get("enabled", True) else "꺼짐",
                " · 계정 %s" % e["account"] if e.get("account") else "", mark))
        return 0

    if "/" not in (args.target or ""):
        raise SystemExit("저장소는 owner/repo 형식입니다: %r" % args.target)

    if args.action == "add":
        entry = dict(repos.get(args.target) or {})
        entry["enabled"] = True
        if args.path:
            entry["localPath"] = args.path
        if args.account:
            entry["account"] = args.account
        repos[args.target] = entry
        cfg_mod.save_raw(raw, args.config)
        print("등록: %s%s" % (args.target,
                            " (로컬 %s)" % entry["localPath"] if entry.get("localPath") else ""))
        lp = os.path.expanduser(entry.get("localPath") or "")
        if lp and not os.path.isdir(os.path.join(lp, ".git")):
            print("  ⚠ 그 경로에 git 클론이 없습니다 — 봇이 캐시에 새로 clone 합니다")
        return 0

    if args.action in ("remove", "disable", "enable"):
        if args.target not in repos:
            raise SystemExit("등록되어 있지 않습니다: %s" % args.target)
        if args.action == "remove":
            del repos[args.target]
            print("해제: %s" % args.target)
        else:
            repos[args.target]["enabled"] = (args.action == "enable")
            print("%s: %s" % (args.target, "켬" if args.action == "enable" else "끔"))
        cfg_mod.save_raw(raw, args.config)
        return 0
    return 1


def cmd_account(args, cfg):
    """봇이 조회·게시에 쓸 gh 계정. 토큰의 주인과 일치해야 게시가 나간다."""
    raw = cfg_mod.load_raw(args.config)
    if args.action == "list":
        cur = raw.get("account")
        print("설정된 계정: %s" % (cur or "(없음 — 그때그때 활성인 gh 계정을 따릅니다)"))
        try:
            print("현재 gh 활성 계정: %s" % (gh.active_account() or "?"))
        except gh.GhError as e:
            print("gh 상태를 읽지 못했습니다: %s" % e)
        if cur:
            try:
                me = gh.whoami(cur)
                print("토큰 주인: %s %s" % (me, "✓" if (me or "").lower() == cur.lower() else "❌ 불일치"))
            except gh.GhError as e:
                print("❌ %s" % e)
        for name, e in sorted((raw.get("repos") or {}).items()):
            if e.get("account"):
                print("  %s → %s (저장소별 지정)" % (name, e["account"]))
        return 0

    if args.action == "set":
        if not args.target:
            raise SystemExit("사용법: review-bot account set <계정>")
        try:
            me = gh.whoami(args.target)
        except gh.GhError as e:
            raise SystemExit("그 계정으로 인증되지 않습니다 (%s) — 먼저 `gh auth login` 하세요" % e)
        if (me or "").lower() != args.target.lower():
            raise SystemExit("토큰의 주인이 %s 입니다 — 계정을 바꾸지 않았습니다" % me)
        raw["account"] = args.target
        cfg_mod.save_raw(raw, args.config)
        print("계정: %s ✓" % args.target)
        return 0

    if args.action == "clear":
        raw.pop("account", None)
        cfg_mod.save_raw(raw, args.config)
        print("계정 지정을 지웠습니다 — 그때그때 활성인 gh 계정을 따릅니다")
        return 0
    return 1


