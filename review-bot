def _summary_body(payload, inline, demoted, verdict=None, note=None):
    """리뷰 규칙의 요약 본문 — 총 건수와 판정, 머지 전 처리 건, 나머지, 검증 범위."""
    everything = inline + demoted
    counts = {}
    for f in everything:
        counts[_label(f)] = counts.get(_label(f), 0) + 1
    tally = " · ".join("%s %d" % (k, counts[k])
                       for k in ("P1", "P2", "P3", "altitude") if counts.get(k))
    verdict = verdict or {}
    # 머리말은 두지 않는다 — 봇이 썼다는 사실은 꼬리말과 MARKER 로 충분하고,
    # 판정은 GitHub 이 리뷰 이벤트로 이미 보여 준다. 본문은 내용부터 시작한다.
    parts = [MARKER]
    parts.append("**총 %d건 (%s)**" % (len(everything), tally or "지적 없음"))
    if note:
        # 같은 PR 에 리뷰가 또 올라오는 이유를 작성자가 첫 줄에서 알 수 있어야 한다.
        parts += ["", "> ℹ️ %s" % note]
    if verdict.get("reason"):
        parts += ["", "> **판정** — %s" % verdict["reason"]]
    if verdict.get("guard"):
        # 판정이 안전장치에 걸려 내려갔으면 그 사실도 PR 작성자에게 보인다.
        parts += ["> ⚠️ %s" % verdict["guard"]]

    # Priority and action are separate: optional P2 feedback can accompany approval.
    must = []
    for action, heading in (("required", "머지 전 수정 필요"),
                            ("uncertain", "사람 확인 필요"),
                            ("optional", "선택적 개선 — 승인에 영향 없음")):
        group = [f for f in everything if policy.disposition(f) == action]
        if not group:
            continue
        must.extend(group)
        parts += ["", "### " + heading, ""]
        for f in group:
            where = "인라인 참고" if f in inline else f["body"].replace("\n", "\n  ")
            parts.append("- **[%s]** `%s` — %s\n  %s" % (_label(f), _loc(f), f["title"], where))

    if payload.get("summary"):
        parts += ["", "### 리뷰어 요약", "", payload["summary"]]

    rest = [f for f in demoted if f not in must]
    if rest:
        parts += ["", "### 나머지", ""]
        for f in rest:
            parts.append("- **[%s]** `%s` — %s\n  %s"
                         % (_label(f), _loc(f), f["title"],
                            f["body"].replace("\n", "\n  ")))
    inline_rest = [f for f in inline if f not in must]
    if inline_rest:
        parts.append("- 그 외 %d건은 인라인 코멘트를 참고하세요." % len(inline_rest))

    parts += ["", "### 검증 범위", ""]
    if payload.get("runtime", {}).get("status") not in (None, "disabled"):
        evidence = payload["runtime"]
        parts.append("head `%s`의 워크트리 코드와 격리 실행 결과를 확인했습니다." % evidence.get("sha", "?"))
        for test in evidence.get("tests") or []:
            label = test["status"]
            base = test.get("baseline") or {}
            if test["status"] == "baseline":
                label = "baseline — 같은 테스트·같은 원인으로 base 에서도 실패, 이 PR 탓이 아님"
            elif test["status"] == "failed" and base.get("exitCode") == 0:
                label = "failed — base 에서는 통과, 이 PR 이 깨뜨림"
            counts = {}
            for case in test.get('cases', []):
                counts[case['status']] = counts.get(case['status'], 0) + 1
            if counts:
                label += " · " + ", ".join("%s %d" % item for item in sorted(counts.items()))
            source = "CI 대체" if test.get('source') == 'ci' else "로컬"
            parts.append("- %s %s: **%s** (`%s`)" % (source, test["name"], label, test["command"]))
        baseline = evidence.get("baseline") or {}
        if baseline.get("status") == "complete":
            parts.append("- 기준선: base `%s` 에서 실패한 명령 %d개를 같은 절차로 재실행했습니다."
                         % (str(baseline.get("sha"))[:10], len(baseline.get("tests") or [])))
        elif baseline.get("status") == "error":
            parts.append("- 기준선: 잡지 못했습니다 — 실패한 테스트를 그대로 둡니다 (%s)" % str(baseline.get("error"))[:120])
        visual = evidence.get("visual") or {}
        parts.append("- 화면 검증: %s — %s" % (visual.get("status", "미실행/해당 없음"), visual.get("summary", "")))
        for limitation in evidence.get("limitations") or []:
            parts.append("- 미확인: " + limitation)
    else:
        parts.append(VERIFY_SCOPE)
    ci = payload.get("ci_evidence") or {}
    if ci:
        parts.append("- CI: %s (head `%s`)" % (ci.get("state"), ci.get("sha")))
        for check in ci.get("checks") or []:
            parts.append("  - %s: %s %s" % (check["name"], check.get("conclusion") or check.get("status"), check.get("url") or ""))
    coverage = payload.get("coverage") or {}
    if coverage:
        parts.append("- 변경 파일 %d개 · %d묶음 · 묶음 검토 완료 %d/%d · 통합 검토 완료 %d/%d" % (
            coverage["files"], coverage["batches"], coverage["completed"], coverage["planned"],
            coverage["integrationCompleted"], coverage["integrationPlanned"]))
        parts.append("- 위 수치는 실행 완료 범위입니다. 실제 추적한 코드와 미확인 사항은 리뷰어 요약을 참고하세요.")
        for missing in coverage.get("unavailable") or []:
            parts.append("- 확인하지 못한 diff: `%s` — %s" % (missing["path"], missing["reason"]))
    for task, replacement in (payload.get('coverageExceptions') or {}).items():
        if isinstance(replacement, dict):
            parts.append("- 보완 검토 %s: %s — %s" % (task, ", ".join(replacement.get('coveredBy') or []),
                                                         replacement.get('reason') or ''))
    for e in payload.get("errors") or []:
        parts.append("- ⚠️ %s — 이 관점은 리뷰에서 빠져 있습니다." % e.split(":")[0])

    return "\n".join(parts)


def _verify_posted(repo, number, result, account=None, login=None):
    """마감 확인 — 유효 판정이 남았는지, 인라인 앵커가 diff 밖으로 떨어지지 않았는지."""
    try:
        result["reviewDecision"] = gh.review_decision(repo, number, account=account)
    except gh.GhError:
        result["reviewDecision"] = None
    try:
        lost = gh.lost_anchors(repo, number, login, MARKER, account=account)
    except gh.GhError:
        lost = None
    result["lostAnchors"] = lost
    _log("  마감 — reviewDecision=%s · 앵커 유실 %s"
         % (result["reviewDecision"] or "NONE", "?" if lost is None else lost))


def _apply_placements(candidates, inline, placements):
    """판정이 정한 게시 형태를 적용한다. inline 은 좌표가 맞을 때만 가능하다."""
    inline_ids = set(id(f) for f in inline)
    fin, fbody, dropped = [], [], []
    for i, f in enumerate(candidates):
        want = placements.get(i) or ("inline" if id(f) in inline_ids else "body")
        if want == "drop":
            dropped.append(f)
            continue
        if want == "inline" and (f.get("_why") or f.get("severity") == "altitude"):
            want = "body"                  # diff 밖이거나 설계 대안이면 본문으로
        (fin if want == "inline" else fbody).append(f)
    return fin, fbody, dropped


def _guard_event(event, findings, payload, pcfg, ci=None):
    """조치 필요성, 핵심 검토 범위, 실행 근거를 확인한 뒤 이벤트를 제한한다."""
    allowed = pcfg.get("allowedEvents") or ["COMMENT"]
    if event not in gh.EVENTS:
        return "COMMENT", "알 수 없는 판정 '%s' 이라 COMMENT 로 게시합니다." % event
    if event not in allowed:
        return "COMMENT", "설정상 %s 는 허용되지 않아 COMMENT 로 게시합니다." % event
    blocked = policy.finding_block(event, findings)
    if blocked:
        return "COMMENT", blocked
    if event == "APPROVE":
        blocked = policy.coverage_block(payload)
        if blocked:
            return "COMMENT", blocked
    if event == "APPROVE" and pcfg.get("approveNeedsGreenCi", True) and ci in ("failure", "pending"):
        return "COMMENT", "CI가 실패했거나 진행 중인 커밋이라 승인하지 않습니다."
    if event == "APPROVE":
        blocked = runtime.approval_block(payload.get("runtime"))
        if blocked:
            return "COMMENT", blocked
    return event, ""


def _connect_repomind(cfg):
    """RepoMind 를 붙이고 한 번 찔러 본다 — (mcp, 중단 사유).

    `mcp` 가 None 이고 사유가 None 이면 그냥 꺼져 있는 것이다. 사유가 있으면
    정찰이 불가능하다는 뜻이고, `repomind.required` 가 켜져 있으면 호출자가
    리뷰를 시작하지 않는다.

    실패를 삼키지 않는 것이 이 함수의 요점이다. 서버가 죽거나 토큰이 만료되면
    리뷰어는 도구만 못 부를 뿐 리뷰는 그럴듯하게 끝나서, 이력 없는 리뷰가 몇 주
    동안 나가도 아무도 모른다. 그래서 로그와 알림 양쪽에 남긴다.
    """
    rc = cfg.get("repomind") or {}
    if not rc.get("enabled"):
        return None, None
    try:
        mcp = repomind_mod.connect(cfg)
        mcp.preflight()
    except repomind_mod.RepomindError as e:
        why = str(e)
        required = rc.get("required", True)
        _log("정찰 불가 — RepoMind: %s" % why)
        _log("  → %s" % ("리뷰를 시작하지 않습니다 (repomind.required=true)" if required
                          else "이력 없이 리뷰를 계속합니다 (repomind.required=false)"))
        notify.send("review-bot · 정찰 불가",
                    "RepoMind: %s" % why[:180],
                    sound=(cfg.get("notify") or {}).get("sound"),
                    enabled=(cfg.get("notify") or {}).get("enabled", True))
        store.log_run({"repo": "-", "number": 0,
                       "error": "repomind: %s" % why[:200],
                       "repomindDown": True, "blocked": bool(required)})
        return None, (why if required else None)
    _log("정찰 준비 — RepoMind %d개 도구" % len(mcp.tools))
    return mcp, None


def _announce_skip(r, cfg, state):
    """크기 상한에 걸린 PR 을 사람에게 알린다 — 커밋 하나당 한 번.

    이 함수가 없던 동안 틱은 "건너뜀" 한 줄을 로그에만 남기고 "새로 리뷰할 PR
    없음" 으로 끝냈다. `runs.jsonl` 에도 `reviewed.json` 에도 아무것도 남지
    않아서, 봇이 일을 안 하는 것인지 할 일이 없는 것인지 로그를 열어 보기
    전에는 구분할 수 없었다. 리뷰를 안 하기로 한 결정은 결정이므로 보고한다.
    """
    if r.get("skipKind") != "size":
        return False
    repo, number, sha = r.get("repo"), r.get("number"), r.get("sha")
    reason = r.get("skipped") or ""
    if store.skip_announced(state, repo, number, sha, reason):
        return False
    store.log_run({"repo": repo, "number": number, "sha": sha,
                   "title": r.get("title"), "skipped": reason,
                   "files": r.get("files"), "churn": r.get("churn")})
    notify.send("review-bot · 너무 커서 건너뜀",
                "%s#%s — %s" % (repo, number, reason),
                sound=(cfg.get("notify") or {}).get("sound"),
                enabled=(cfg.get("notify") or {}).get("enabled", True))
    store.mark_skip_announced(state, repo, number, sha, reason)
    store.save(state)
    _log("  → 알림을 보냈습니다. 그래도 보려면 "
         "`review-bot review %s#%s --force-size`" % (repo, number))
    return True


def _cleanup_worktree(base, path, ref, result):
    errors = list(worktree.cleanup(base, path, ref) or [])
    if errors:
        result.setdefault('cleanup_errors', []).extend(errors)
        for error in errors:
            _log('워크트리 정리 미완료 — ' + error)


def process_pr(pr, cfg, state, force=False, mcp=None, force_size=False, rejudge=False):
    try:
        return _process_pr(pr, cfg, state, force, mcp, force_size, rejudge)
    finally:
        store.clear_current()


def _process_pr(pr, cfg, state, force=False, mcp=None, force_size=False, rejudge=False):
    """PR 하나를 리뷰하고 게시까지. 결과 dict 를 돌려준다."""
    repo, number = pr["repo"], pr["number"]
    rcfg, pcfg = cfg["review"], cfg["post"]
    result = {"repo": repo, "number": number, "title": pr.get("title") or ""}

    entry = cfg_mod.repo_entry(cfg, repo)
    if not entry:
        return dict(result, skipped="화이트리스트에 없는 저장소")

    # 어느 이름으로 게시할지는 설정이 정하고, 그 이름이 맞는지는 토큰이 증명한다.
    acct = entry.get("account") or cfg.get("account")
    me = gh.whoami(acct) if acct else (gh.active_account() or "")
    if acct and (me or "").lower() != acct.lower():
        raise gh.GhError("계정 불일치 — 설정은 %s 인데 토큰의 주인은 %s 입니다. 게시하지 않습니다."
                         % (acct, me or "?"))
    genv = gh.env_for(acct)
    result["account"] = me

    meta = gh.pr_meta(repo, number, account=acct)
    meta["_repo"], meta["_number"] = repo, number
    sha = meta.get("headRefOid")
    result["sha"] = sha

    if meta.get("state") != "OPEN":
        checkpoints.stop(repo, number)
        return dict(result, skipped="열려 있지 않음")
    # 본인 PR 에는 인라인을 달지 않는다 — 지적은 수정 커밋으로 반영하는 것이 규칙이다.
    if me and ((meta.get("author") or {}).get("login") or "").lower() == me.lower():
        return dict(result, skipped="본인 PR")
    if rcfg.get("skipDrafts", True) and meta.get("isDraft"):
        return dict(result, skipped="draft")
    # 나에게 온 마지막 리뷰 요청. 건너뛸지 가르는 데 쓰고, 리뷰하면 "이 요청에
    # 답했다" 는 표시로 기록에 남긴다. 리뷰할 때마다 반드시 받아 둬야 한다 — 기록에
    # 이 시각이 비어 있으면 다음 틱이 열려 있는 요청을 재요청으로 오인해 같은 커밋을
    # 또 리뷰한다.
    requested = None
    try:
        requested = gh.last_review_request(repo, number, me, account=acct)
    except gh.GhError as e:
        # 재요청을 못 보면 건너뛰게 된다. 돈이 드는 일이라 그쪽이 안전하지만, 왜
        # 안 잡혔는지 모르면 사람이 봇을 의심하게 되므로 이유는 남긴다.
        _log("  리뷰 요청 이력을 읽지 못했습니다 — 재요청은 다음 틱에서 봅니다: %s"
             % str(e)[:80])
    result["requestedAt"] = (requested or {}).get("at")
    identity = checkpoints.identity(meta, cfg, me)
    cached = checkpoints.load(repo, number, identity) if (rejudge or pr.get('_rejudge')) else None
    if pr.get('_rejudge') and not cached:
        checkpoints.stop(repo, number)
        return dict(result, skipped="base/head 또는 정책 변경 — 새 리뷰 요청에서 다시 검토")
    if (cached and result['requestedAt'] and cached.get('requestedAt')
            and result['requestedAt'] != cached['requestedAt']):
        cached = None
    if cached and not force and checkpoints.unchanged_wait(cached, gh.ci_evidence(meta)):
        return dict(result, skipped="검증 대기 — CI 상태 변화 없음")
    if not force and not cached and store.already_done(state, repo, number, sha,
                                        rcfg.get("rereviewOnNewCommits", True),
                                        pcfg.get("dryRun", True),
                                        requested_at=result["requestedAt"]):
        return dict(result, skipped="이미 리뷰함")

    all_files = gh.pr_files(repo, number, account=acct)
    if meta.get("changedFiles") is not None and len(all_files) != meta["changedFiles"]:
        raise reviewer.ReviewError("변경 파일 목록이 불완전합니다 (%d/%d). 리뷰를 게시하지 않습니다."
                                   % (len(all_files), meta["changedFiles"]))
    files = [f for f in all_files if not _skip_file(f.get("filename") or "", rcfg)]
    if not files:
        return dict(result, skipped="리뷰할 파일 없음")
    churn = sum((f.get("additions") or 0) + (f.get("deletions") or 0) for f in files)
    cap_f = rcfg.get("maxChangedFiles", 0)
    cap_l = rcfg.get("maxDiffLines", 0)
    over = []
    if cap_f > 0 and len(files) > cap_f:
        over.append("파일 %d개(상한 %d)" % (len(files), cap_f))
    if cap_l > 0 and churn > cap_l:
        over.append("%d줄(상한 %d)" % (churn, cap_l))
    if over and not force_size:
        # 두 축을 한 번에 알려 준다. 하나씩 걸리면 상한을 올려도 다음 틱에서 다른
        # 축에 다시 걸려, 고치는 사람이 같은 자리를 두 번 오게 된다.
        # skipKind 로 표시해 두는 것은 이 건너뜀만 사람에게 알리기 위해서다 —
        # "이미 리뷰함", "본인 PR" 같은 것은 설계대로 동작한 것이라 알릴 일이 아니다.
        return dict(result, skipped=" · ".join(over) + " — 상한 초과",
                    skipKind="size", files=len(files), churn=churn)
    if over and force_size:
        _log("  상한 초과(%s) — --force-size 로 그대로 진행합니다" % " · ".join(over))

    meta["_ci"] = gh.ci_state(meta)
    meta["_ci_evidence"] = gh.ci_evidence(meta)

    reuse = (cached or {}).get('_reuse') or {}
    reuse_review = bool(cached and reuse.get('review'))
    reuse_runtime = bool(cached and reuse.get('runtime'))
    saved_runtime = runtime.refresh_ci(cached['payload'].get('runtime') or {}, meta) if reuse_runtime else None
    execution_ready = bool(saved_runtime) and not runtime.approval_block(saved_runtime)
    needs_execution = not execution_ready and (not cached or rejudge or not reuse_runtime)
    result['cache'] = {'review': False, 'runtime': execution_ready, 'decision': False}
    runtime_ran = False
    if needs_execution:
        environment = preflight.check(
            cfg_mod._merge(rcfg.get('runtime') or {}, entry.get('runtime') or {}), store.STATE_DIR)
        if not environment['ok']:
            _log('  실행 환경 대기 — ' + environment['reason'])
            return dict(result, event='PENDING', pending=True, deferred=True, posted=False,
                        reason=environment['reason'], preflight=environment,
                        decision=policy.decision(None, 'PENDING', [], {}, environment=environment))

    _log("  리뷰 시작 — 파일 %d · %d줄" % (len(files), churn))
    # 지금 무엇을 보고 있는지 남긴다 — 앱의 라이브 세션 화면이 이걸 읽는다.
    requester = (requested or {}).get("by")
    if not requester:
        try:
            requester = gh.review_requester(repo, number, me, account=acct)
        except gh.GhError:
            requester = None
    store.set_current({
        "repo": repo, "number": number, "title": result.get("title") or meta.get("title") or "",
        "author": (meta.get("author") or {}).get("login") or "",
        "requestedBy": requester, "sha": sha, "account": me,
        "files": len(files), "churn": churn, "agents": rcfg["agents"],
        "startedAt": time.strftime("%Y-%m-%dT%H:%M:%S"),
        "url": "https://github.com/%s/pull/%s" % (repo, number),
    })
    verify_rows = []
    wt = None
    if reuse_review and (not cached['payload'].get('errors') or not rejudge):
        _log("  저장된 코드 검토 재사용 — 실행 근거와 최종 판정만 갱신")
        payload = cached['payload']
        files = cached['files']
        files_by_path = {f['filename']: {'postable': gh.postable_lines(f.get('patch')),
                                        'added': gh.added_lines(f.get('patch')),
                                        'patch': f.get('patch') or ''} for f in files}
        result['cache']['review'] = True
        payload['runtime'] = saved_runtime or {}
        if needs_execution:
            wt = base = ref = None
            try:
                wt, wsha, base, ref = worktree.prepare(repo, number, entry.get('localPath'), env=genv)
                if wsha != sha:
                    raise reviewer.ReviewError("재검증 준비 중 head가 바뀌었습니다")
                payload['runtime'] = runtime.collect(
                    meta, files, wt, cfg_mod._merge(rcfg.get('runtime') or {}, entry.get('runtime') or {}),
                    progress=lambda message: _log('  ' + message), env=genv,
                    previous=saved_runtime)
                runtime_ran = True
            finally:
                if wt and base:
                    _cleanup_worktree(base, wt, ref, result)
        meta['_runtime'] = payload['runtime']
        payload['ci_evidence'] = meta['_ci_evidence']
        payload.setdefault('_meta', {})['cost_usd'] = (
            payload['runtime'].get('cost_usd', 0) if runtime_ran else 0)
        result.update(runtime=payload['runtime'], ci_evidence=meta['_ci_evidence'], reusedReview=True)
    else:
        wt = base = ref = None
        ok = False
        try:
            wt, wsha, base, ref = worktree.prepare(repo, number, entry.get("localPath"),
                                                   env=genv)
            if wsha != sha:
                raise reviewer.ReviewError("리뷰 준비 중 PR head가 바뀌었습니다. 다음 실행에서 다시 확인합니다.")
            files = worktree.complete_patches(base, sha, meta.get("baseRefOid"), files, env=genv)
            files_by_path = {f["filename"]: {"postable": gh.postable_lines(f.get("patch")),
                                             "added": gh.added_lines(f.get("patch")),
                                             "patch": f.get("patch") or ""}
                             for f in files}
            def progress(tag, coverage):
                _log("  %s — 묶음 검토 %d/%d · 통합 %d/%d" % (
                    tag, coverage["completed"], coverage["planned"],
                    coverage["integrationCompleted"], coverage["integrationPlanned"]))
                current = store.read_current() or {}
                current.update(phase=tag, coverage=coverage)
                store.set_current(current)

            # 리뷰어는 Bash 가 없어 이력을 스스로 캐지 못한다. 워크트리에 남의 PR 코드가
            # 펼쳐져 있는 이상 거기서 명령이 돌게 할 수는 없으므로, 신뢰되는 이쪽에서
            # 읽어 프롬프트에 실어 준다. 실패해도 리뷰는 그대로 진행한다.
            ctx = {"history": worktree.file_history(base, wsha, list(files_by_path)),
                   "comments": gh.file_review_comments(repo, list(files_by_path),
                                                       account=acct)}
            _log("  맥락: 커밋이력 %d파일 · 과거 코멘트 %d파일 · 정찰 %s"
                 % (len(ctx["history"]), len(ctx["comments"]),
                    "RepoMind" if mcp else "없음"))
            def runtime_progress(message):
                _log("  " + message)
                current = store.read_current() or {}
                current.update(phase=message)
                store.set_current(current)

            if needs_execution:
                meta['_runtime'] = runtime.collect(
                    meta, files, wt, cfg_mod._merge(rcfg.get('runtime') or {}, entry.get('runtime') or {}),
                    progress=runtime_progress, env=genv, previous=saved_runtime)
                runtime_ran = True
            else:
                meta['_runtime'] = saved_runtime
            # CI may finish while the isolated execution is running.
            refreshed = gh.pr_meta(repo, number, account=acct)
            if refreshed.get("headRefOid") != sha or refreshed.get("baseRefOid") != meta.get("baseRefOid"):
                raise reviewer.ReviewError("실행 검증 중 base/head가 바뀌어 다시 리뷰해야 합니다.",
                                           cost=meta["_runtime"].get("cost_usd"))
            meta["_ci"] = gh.ci_state(refreshed)
            meta["_ci_evidence"] = gh.ci_evidence(refreshed)
            try:
                payload = reviewer.review(meta, files, rcfg["agents"], cwd=wt,
                                          model=rcfg.get("model"),
                                          max_turns=rcfg.get("maxTurns", 0),
                                          timeout=rcfg.get("timeoutSec") or 3600,
                                          parallel=rcfg.get("parallel", True), ctx=ctx,
                                          mcp=mcp, batching=rcfg, progress=progress,
                                          previous_tasks=cached["payload"].get("_tasks") if reuse_review else None,
                                          diff_cap=reviewer.diff_char_cap(
                                              rcfg.get("maxDiffLines")))
            except reviewer.ReviewError as exc:
                payload = {'findings': [], 'summary': '코드 검토를 완료하지 못했습니다. 실패 원인 해결 후 검토가 필요합니다.',
                           'errors': ['review: ' + str(exc)[:300]],
                           'coverage': {},
                           '_meta': {'cost_usd': exc.cost or 0, 'agents': {}}}
            payload["runtime"] = meta["_runtime"]
            payload["ci_evidence"] = meta["_ci_evidence"]
            payload.setdefault("_meta", {})["cost_usd"] = (
                (payload.get("_meta", {}).get("cost_usd") or 0) + (meta["_runtime"].get("cost_usd", 0) if runtime_ran else 0))
            result["runtime"] = meta["_runtime"]
            result["ci_evidence"] = meta["_ci_evidence"]
            result["review_execution"] = dict(payload.get("_meta") or {})
            # 반증 — 워크트리가 살아 있는 이 안에서만 가능하다. 판정 단계는 코드를
            # 볼 수 없으므로 근거의 문체로만 판단한다. 여기서는 코드를 다시 읽는다.
            # 범위 — 반증보다 먼저다. diff 밖의 지적은 검증할 가치도 비용도 없다.
            payload["findings"], out_of_scope = _scope_findings(
                payload.get("findings") or [], files_by_path,
                strict=rcfg.get("strictScope", True))
            if out_of_scope:
                result["out_of_scope"] = len(out_of_scope)
                _log("  범위 밖 %d건 버림" % len(out_of_scope))
                for f in out_of_scope:
                    _log("    %s — %s:%s (%s)" % ((f.get("title") or "")[:50],
                                                 f.get("path"), f.get("line") or "?",
                                                 f.get("_why") or "diff 밖"))
            vcfg = rcfg.get("verify") or {}
            verify_rows = []
            if vcfg.get("enabled", True) and payload.get("findings"):
                try:
                    kept, rejected, vcost = reviewer.verify(
                        payload["findings"], meta, cwd=wt,
                        model=vcfg.get("model") or "haiku",
                        timeout=vcfg.get("timeoutSec") or 300,
                        max_turns=vcfg.get("maxTurns", 15),
                        workers=vcfg.get("workers", 4),
                        patches={p: e["patch"] for p, e in files_by_path.items()})
                except (reviewer.ReviewError, OSError) as e:
                    # 검증이 통째로 실패하면 검증 이전 상태로 돌아간다 — 리뷰를
                    # 버리지는 않는다.
                    _log("  반증 단계 실패 → 지적을 그대로 둡니다: %s" % str(e)[:120])
                else:
                    payload["findings"] = kept
                    payload["_meta"]["cost_usd"] = round(
                        (payload["_meta"].get("cost_usd") or 0) + vcost, 4)
                    result["verified"] = {"kept": len(kept), "rejected": len(rejected),
                                          "cost_usd": vcost}
                    for i, f in enumerate(kept):
                        f["_vid"] = i          # _validate 의 사본에도 딸려 간다
                    verify_rows = list(kept) + [dict(f, _fate="rejected")
                                                for f in rejected]
                    _log("  반증 %d건 통과 · %d건 반증됨" % (len(kept), len(rejected)))
                    for f in rejected:
                        v = f.get("_verify") or {}
                        _log("    반증됨 (진짜일 가능성 %s/100) %s — %s"
                             % (v.get("confidence", "?"),
                                (f.get("title") or "")[:50], (v.get("reason") or "")[:90]))
            ok = True
        finally:
            if wt and base:
                _cleanup_worktree(base, wt, ref, result)
            # 모든 리뷰어가 성공했을 때만 세션 기록을 버린다. 하나라도 실패했으면 그
            # transcript 가 원인을 볼 유일한 단서라 남겨 두고, gc 가 보존 기간 뒤 치운다.
            if (wt and ok and not payload.get("errors")
                    and (cfg.get("gc") or {}).get("dropSessionOnSuccess", True)):
                janitor.drop_session(wt)
            store.clear_current()

    store.clear_current()
    result["coverage"] = payload.get("coverage")
    result["cost_usd"] = (payload.get("_meta") or {}).get("cost_usd")
    if payload.get("errors"):
        result["agent_errors"] = payload["errors"]
        for e in payload["errors"]:
            _log("  에이전트 실패: %s" % e[:150])
    inline, demoted = _validate(payload.get("findings") or [], files_by_path, pcfg)

    snapshot = {'identity': identity, 'payload': payload, 'files': files,
                'title': result.get('title') or meta.get('title') or '',
                'requestedAt': result.get('requestedAt'),
                'created': (cached or {}).get('created', time.time()),
                'ci': meta['_ci_evidence'], 'watchCI': False,
                'waitingSince': (cached or {}).get('waitingSince', time.time())}
    # 판정 — 리뷰어들의 결과를 놓고 event 와 지적별 게시 형태를 정한다.
    candidates = inline + demoted          # 이 순서가 판정에 넘기는 id 다
    verdict = {"event": "COMMENT", "reason": "", "guard": "", "placements": {}}
    judgment_key = checkpoints.judgment_key(identity, payload, candidates, meta['_ci_evidence'])
    saved_verdict = checkpoints.saved_judgment(cached, judgment_key)
    if saved_verdict and pcfg.get('autonomous', True):
        verdict.update(saved_verdict)
        result['cache']['decision'] = True
        _log('  최종 판정 재사용 — 같은 검토·실행 근거·CI')
    elif pcfg.get("autonomous", True):
        try:
            verdict.update(reviewer.judge(
                meta, payload, candidates,
                pcfg.get("allowedEvents") or ["COMMENT"],
                model=pcfg.get("judgeModel") or "sonnet"))
            _log("  판정 %s — %s" % (verdict["event"], verdict["reason"][:80]))
        except reviewer.ReviewError as e:
            _log("  판정 실패 → COMMENT: %s" % str(e)[:120])
            verdict["guard"] = "판정 단계가 실패해 COMMENT 로 게시합니다."
            verdict["failed"] = True
            result["cost_usd"] = (result.get("cost_usd") or 0) + (e.cost or 0)
    if pcfg.get('autonomous', True) and not verdict.get('failed'):
        snapshot['judgment'] = {'key': judgment_key, 'verdict': json.loads(json.dumps(verdict))}
    judge_event = verdict["event"] if pcfg.get("autonomous", True) and not verdict.get("failed") else None
    for index, finding in enumerate(candidates):
        finding.update((verdict.get("dispositions") or {}).get(index) or {})
    payload["coverageExceptions"] = verdict.get("coverageExceptions") or {}
    inline, demoted, dropped = _apply_placements(candidates, inline,
                                                 verdict.get("placements") or {})
    verdict["event"], guard = _guard_event(verdict["event"], inline + demoted,
                                           payload, pcfg, ci=meta.get("_ci"))
    if guard:
        _log("  안전장치: %s" % guard)
        verdict["guard"] = guard

    # 반증이 매긴 confidence 를 그 지적이 끝내 어떻게 됐는지와 함께 남긴다.
    # 지금은 아무것도 거르지 않는다 — 점수의 컷이 필요한지, 필요하면 몇 점인지는
    # 이 로그가 쌓인 뒤 분포로 답할 문제다.
    if verify_rows:
        fates = {}
        for label, group in (("inline", inline), ("body", demoted), ("drop", dropped)):
            for f in group:
                if f.get("_vid") is not None:
                    fates[f["_vid"]] = label
        for f in verify_rows:
            if not f.get("_fate"):
                # 여기 없으면 좌표 검증이나 등급 문턱에서 빠진 것이다
                f["_fate"] = fates.get(f.get("_vid"), "filtered")
        store.log_verify(repo, number, sha, verify_rows)
    if verdict.get("cost_usd"):
        result["cost_usd"] = round((result.get("cost_usd") or 0) + verdict["cost_usd"], 4)
    result.update(inline=len(inline), demoted=len(demoted), dropped=len(dropped),
                  event=verdict["event"], reason=verdict["reason"],
                  summary=payload.get("summary") or "")

    def record_decision(event, ci):
        result['decision'] = policy.decision(
            judge_event, event, inline + demoted, payload, reason=verdict['reason'],
            guard=verdict.get('guard', ''), ci=ci, judge_failed=verdict.get('failed', False))
        result.update(event=event, reason=result['decision']['summary'])

    waiting = (meta.get('_ci') == 'pending' and verdict['event'] == 'COMMENT'
               and not any(policy.disposition(f) == 'required' for f in inline + demoted)
               and time.time() - snapshot['waitingSince'] < 86400)
    snapshot.update(waiting=waiting, watchCI=meta.get('_ci') in ('pending', 'failure'))
    checkpoints.save(repo, number, snapshot)
    record_decision("PENDING" if waiting else verdict["event"], meta.get("_ci"))
    if waiting:
        _log("  검증 대기 — CI 완료 후 저장된 검토로 재판정합니다")
        return dict(result, event="PENDING", pending=True, posted=False)
    if (cached and cached.get('posted') and cached.get('event') == verdict['event']
            and not rejudge):
        snapshot.update(posted=True, event=verdict['event'])
        checkpoints.save(repo, number, snapshot)
        return dict(result, skipped="재판정 결과 동일 — 중복 게시하지 않음")

    # 게시 직전 문장 다듬기. 마크다운 전체가 아니라 **구성 요소**만 넘긴다 —
    # 제목·라벨·문서 구조는 코드가 조립하므로 편집자가 건드릴 일이 없다.
    # 리뷰어별 긴 검토 기록은 다시 생성하지 않는다. 지적 본문과 판정만 다듬는다.
    polcfg = pcfg.get("polish") or {}
    targets = ([f.get("body") or "" for f in inline]
               + [verdict.get("reason") or ""])
    if polcfg.get("enabled", True) and any(t.strip() for t in targets):
        polished, changed, reverted, pcost = reviewer.polish(
            targets, model=polcfg.get("model") or "sonnet",
            timeout=polcfg.get("timeoutSec") or 300)
        for f, t in zip(inline, polished):
            f["body"] = t
        verdict["reason"] = polished[len(inline)]
        result["reason"] = verdict["reason"]
        result["polished"] = {"changed": changed, "reverted": reverted,
                              "of": len(targets), "cost_usd": round(pcost, 4)}
        if pcost:
            result["cost_usd"] = round((result.get("cost_usd") or 0) + pcost, 4)
        _log("  문장 다듬기 %d/%d건 반영%s"
             % (changed, len(targets),
                " · %d건은 내용이 바뀌어 원문 유지" % reverted if reverted else ""))

    record_decision(verdict["event"], meta.get("_ci"))
    body = _summary_body(payload, inline, demoted, verdict, note=pcfg.get("note"))
    comments = [{"path": f["path"], "line": f["line"], "side": "RIGHT",
                 "body": _comment_body(f)} for f in inline]
    patches = {f.get("filename"): f.get("patch") for f in files}

    if pcfg.get("dryRun", True):
        path = store.draft_path(repo, number)
        with open(path, "w", encoding="utf-8") as fp:
            fp.write("<!-- event: %s -->\n" % verdict["event"])
            fp.write(body + "\n\n---\n\n")
            for c in comments:
                fp.write("### %s:%s\n%s\n\n" % (c["path"], c["line"], c["body"]))
            if dropped:
                fp.write("---\n\n### 판정이 버린 지적 %d건\n" % len(dropped))
                for f in dropped:
                    fp.write("- [%s] %s\n" % (f["severity"], f["title"]))
        # 사람이 읽는 .md 옆에 게시용 사본을 남긴다. 검토 후 게시할 때 리뷰를 다시
        # 돌리지 않으려면 지금 만들어진 body 와 인라인 좌표가 그대로 있어야 한다.
        payload_path = store.draft_payload_path(repo, number)
        with open(payload_path, "w", encoding="utf-8") as fp:
            json.dump({
                "repo": repo, "number": number, "title": result.get("title") or "",
                "sha": sha, "baseSha": meta.get("baseRefOid"), "account": me, "event": verdict["event"],
                "reason": result["reason"], "decision": result["decision"], "body": body,
                "comments": [dict(c, hunk=gh.hunk_around(patches.get(c["path"]), c["line"]))
                             for c in comments],
                "inline": len(inline), "demoted": len(demoted),
                "dropped": [{"severity": f.get("severity"), "title": f.get("title")}
                            for f in dropped],
                "cost_usd": result.get("cost_usd"),
                "requestedAt": result.get("requestedAt"),
                "at": time.strftime("%Y-%m-%dT%H:%M:%S"),
            }, fp, ensure_ascii=False, indent=2)
        result["draft"] = path
        result["draftPayload"] = payload_path
        result["posted"] = False
        return result

    latest = gh.pr_meta(repo, number, account=acct)
    if latest.get("headRefOid") != sha or latest.get("baseRefOid") != meta.get("baseRefOid"):
        raise reviewer.ReviewError("리뷰 중 base/head가 바뀌어 게시하지 않았습니다.", cost=result.get("cost_usd"))

    latest_ci = gh.ci_evidence(latest)
    snapshot.update(ci=latest_ci, watchCI=latest_ci['state'] in ('pending', 'failure'))
    if (latest_ci['state'] == 'pending' and verdict['event'] != 'REQUEST_CHANGES'
            and time.time() - snapshot['waitingSince'] < 86400):
        snapshot['waiting'] = True
        verdict['guard'] = 'CI 완료를 기다립니다.'
        record_decision('PENDING', latest_ci['state'])
        result['ci_evidence'] = latest_ci
        checkpoints.save(repo, number, snapshot)
        return dict(result, event="PENDING", pending=True, posted=False)
    snapshot['waiting'] = False
    checkpoints.save(repo, number, snapshot)
    ci_changed = latest_ci != payload.get("ci_evidence")
    payload["ci_evidence"] = latest_ci
    result["ci_evidence"] = latest_ci
    event, guard = _guard_event(judge_event or verdict["event"], inline + demoted, payload, pcfg, latest_ci["state"])
    guard_changed = guard != verdict.get("guard", "")
    if not verdict.get("failed"):
        verdict.update(event=event, guard=guard)
    record_decision(verdict["event"], latest_ci["state"])
    if ci_changed or guard or guard_changed:
        body = _summary_body(payload, inline, demoted, verdict, note=pcfg.get("note"))

    # 게시는 단계적으로 내려간다. 자기 PR 에 APPROVE 를 내면 422 이므로 이벤트만
    # COMMENT 로 바꿔 한 번 더, 그래도 실패면 inline 좌표 문제이니 요약 코멘트로.
    try:
        gh.post_review(repo, number, sha, body, comments, event=verdict["event"],
                       account=acct)
        result["posted"] = True
        snapshot.update(posted=True, event=verdict["event"])
        checkpoints.save(repo, number, snapshot)
        _verify_posted(repo, number, result, acct, me)
        return result
    except gh.GhError as e:
        first = str(e)[:200]
        _log("  %s 게시 실패: %s" % (verdict["event"], first[:120]))
    if verdict["event"] != "COMMENT":
        try:
            fallback_v = dict(verdict, event="COMMENT",
                              guard="%s 게시가 거절되어 COMMENT 로 내렸습니다." % verdict["event"])
            gh.post_review(repo, number, sha,
                           _summary_body(payload, inline, demoted, fallback_v,
                                         note=pcfg.get("note")),
                           comments, event="COMMENT", account=acct)
            result.update(posted=True, event="COMMENT", degraded=True, post_error=first)
            result["decision"] = policy.revise_decision(result.get("decision"), "COMMENT", "PUBLISH_FAILED", first, "github")
            result["reason"] = result["decision"]["summary"]
            snapshot.update(posted=True, event="COMMENT")
            checkpoints.save(repo, number, snapshot)
            _verify_posted(repo, number, result, acct, me)
            return result
        except gh.GhError as e:
            _log("  COMMENT 재시도 실패: %s" % str(e)[:120])
    fallback_v = dict(verdict, event="COMMENT",
                      guard="inline 게시가 거절되어 요약만 남깁니다.")
    gh.post_issue_comment(repo, number,
                          _summary_body(payload, [], inline + demoted, fallback_v,
                                        note=pcfg.get("note")),
                          account=acct)
    result.update(posted=True, event="COMMENT", degraded=True, post_error=first)
    result["decision"] = policy.revise_decision(result.get("decision"), "COMMENT", "PUBLISH_FAILED", first, "github")
    result["reason"] = result["decision"]["summary"]
    snapshot.update(posted=True, event="COMMENT")
    checkpoints.save(repo, number, snapshot)
    return result


def _publish(repo, number, cfg, preview=False):
    """저장된 초안을 리뷰 없이 그대로 게시한다.

    process_pr 의 게시 사다리와 형태는 같지만 입력이 다르다 — 거기서는 방금 만든
    payload 로 본문을 다시 조립할 수 있고, 여기서는 그때 굳어진 본문 하나뿐이다.
    되돌릴 수 없는 게시라, 좌표가 어긋나는 조건이면 올리지 않고 물러난다.
    """
    path = store.draft_payload_path(repo, number)
    if not os.path.exists(path):
        _log("게시할 초안이 없습니다 (%s)" % path)
        return 1
    try:
        with open(path, encoding="utf-8") as f:
            d = json.load(f)
    except (ValueError, OSError) as e:
        _log("초안을 읽지 못했습니다: %s" % e)
        return 1

    entry = cfg_mod.repo_entry(cfg, repo)
    if not entry:
        _log("화이트리스트에 없는 저장소입니다 — 게시하지 않습니다")
        return 1
    acct = entry.get("account") or cfg.get("account")
    me = gh.whoami(acct) if acct else (gh.active_account() or "")
    if acct and (me or "").lower() != acct.lower():
        _log("계정 불일치 — 설정은 %s 인데 토큰의 주인은 %s 입니다. 게시하지 않습니다."
             % (acct, me or "?"))
        return 1

    meta = gh.pr_meta(repo, number, account=acct)
    if meta.get("state") != "OPEN":
        _log("PR 이 열려 있지 않습니다 — 게시하지 않습니다")
        return 1
    head = meta.get("headRefOid")
    if head != d.get("sha") or (d.get("baseSha") and meta.get("baseRefOid") != d["baseSha"]):
        _log("초안을 만든 뒤 새 커밋이 올라왔습니다 (초안 %s → 현재 %s)."
             % (str(d.get("sha"))[:12], str(head)[:12]))
        _log("  인라인 좌표가 어긋나므로 게시하지 않습니다 — `review-bot review %s#%s` 로 다시 리뷰하세요."
             % (repo, number))
        return 2

    comments = d.get("comments") or []
    event = d.get("event") or "COMMENT"
    body = d.get("body") or ""
    decision = d.get("decision") or {"judgeEvent": event, "finalEvent": event, "summary": d.get("reason") or "", "reasons": []}
    if event == "APPROVE" and cfg["post"].get("approveNeedsGreenCi", True) and gh.ci_state(meta) in ("failure", "pending"):
        event = "COMMENT"
        message = "CI가 실패했거나 진행 중이어서 승인 대신 코멘트로 게시합니다."
        body += "\n\n" + message
        decision = policy.revise_decision(decision, event, "CI_PENDING" if gh.ci_state(meta) == "pending" else "CI_FAILED", message, "ci")
    if preview:
        print("게시 예정 — %s#%s · %s · 인라인 %d · 본문 %d"
              % (repo, number, event, len(comments), d.get("demoted") or 0))
        print("커밋 %s (현재 head 와 일치)" % str(head)[:12])
        for c in comments:
            print("  · %s:%s" % (c.get("path"), c.get("line")))
        print("--- 요약 본문 %d자 ---" % len(body))
        print(body[:600] + ("…" if len(body) > 600 else ""))
        return 0

    result = {"repo": repo, "number": number, "title": d.get("title") or "",
              "account": me, "sha": head, "event": event, "published": True,
              "inline": len(comments), "demoted": d.get("demoted") or 0,
              "dropped": len(d.get("dropped") or []), "cost_usd": 0.0,
              "reason": decision.get("summary") or "", "decision": decision}
    first = None
    try:
        gh.post_review(repo, number, head, body, comments, event=event, account=acct)
        result["posted"] = True
    except gh.GhError as e:
        first = str(e)[:200]
        _log("  %s 게시 실패: %s" % (event, first[:120]))
        note = "\n\n> ⚠️ %s 게시가 거절되어 COMMENT 로 내렸습니다." % event
        try:
            if event == "COMMENT":
                raise gh.GhError(first)
            gh.post_review(repo, number, head, body + note, comments,
                           event="COMMENT", account=acct)
            result.update(posted=True, event="COMMENT", degraded=True, post_error=first)
        except gh.GhError as e2:
            _log("  COMMENT 재시도 실패: %s" % str(e2)[:120])
            gh.post_issue_comment(
                repo, number,
                body + "\n\n> ⚠️ 인라인 게시가 거절되어 요약만 남깁니다.", account=acct)
            result.update(posted=True, event="COMMENT", degraded=True,
                          inline=0, post_error=first)

    if result.get("degraded"):
        result["decision"] = policy.revise_decision(result.get("decision"), result["event"], "PUBLISH_FAILED", first, "github")
        result["reason"] = result["decision"]["summary"]
    _verify_posted(repo, number, result, acct, me)
    state = store.load()
    prev = state.get(store.key(repo, number)) or {}
    store.mark(state, repo, number, head, inline=result.get("inline"),
               demoted=result.get("demoted"), posted=True,
               cost_usd=prev.get("cost_usd") or d.get("cost_usd"),
               requestedAt=d.get("requestedAt"),
               event=result.get("event"), decision=result.get("decision"))
    store.save(state)
    store.log_run(result)
    try:
        os.remove(path)                 # 게시했으니 대기 목록에서 뺀다 (.md 는 남는다)
    except OSError:
        pass
    _log("게시 — %s · inline %d · 요약 %d"
         % (EVENT_LABEL.get(result.get("event"), result.get("event") or "-"),
            result.get("inline") or 0, result.get("demoted") or 0))
    return 0


def cmd_publish(args, cfg):
    repo, number = _parse_target(args.target)
    if not store.acquire_lock():
        _log("틱이 돌고 있습니다 — 끝난 뒤 다시 부르세요.")
        return 1
    try:
        return _publish(repo, number, cfg, preview=args.dry_run)
    finally:
        store.release_lock()


