def main():
    _install_signal_handlers()
    ap = argparse.ArgumentParser(prog="review-bot", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--config", help="설정 파일 경로")
