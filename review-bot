def _same_file_as_stdout(path):
    """stdout 이 이미 그 파일인가 (launchd 가 리다이렉트한 경우)."""
    try:
        a = os.fstat(sys.stdout.fileno())
        b = os.stat(path)
        return (a.st_dev, a.st_ino) == (b.st_dev, b.st_ino)
    except (OSError, ValueError):
        return False


def _log(msg):
    line = "%s %s" % (time.strftime("%H:%M:%S"), msg)
    try:
        print(line, flush=True)
    except (BrokenPipeError, OSError):
        # 읽던 쪽이 사라졌다고 리뷰가 죽어서는 안 된다. 앱이 종료되며 파이프가 끊겨
        # 판정 단계에서 리뷰 한 건이 통째로 날아간 적이 있다 — 기록은 아래에 남긴다.
        pass
    # launchd 로 뜨면 stdout 이 곧 bot.log 라 그대로 두면 되지만, 터미널이나 앱에서
    # 부르면 아무 데도 남지 않는다 — 앱의 "지금 틱" 으로 돈 리뷰가 로그에서 통째로
    # 사라졌다. 같은 파일이 아닐 때만 덧붙인다.
    # 날짜별 파일이 사람이 읽는 로그다. stdout 이 bot.log 로 리다이렉트돼 있어도
    # 여기에는 따로 적는다 — 그래야 하루치만 꺼내 보거나 오래된 날을 지울 수 있다.
    store.append_day_log(line)
    if _same_file_as_stdout(store.LOG_TEXT):
        return
    try:
        with open(store.LOG_TEXT, "a", encoding="utf-8") as f:
            f.write(line + "\n")
    except OSError:
        pass


def _skip_file(name, review_cfg):
    for g in review_cfg.get("excludeGlobs") or []:
        if g in name:
            return True
    exts = review_cfg.get("includeExts") or []
    if exts and not any(name.endswith(e) for e in exts):
        return True
    return False


def _snap_line(line, postable, tolerance=3):
    """모델이 준 라인이 diff 밖이면 가까운 코멘트 가능 라인으로 당긴다.

    한두 줄 어긋났다고 맞는 지적을 버리긴 아깝고, 멀리 떨어진 걸 억지로 붙이면
    엉뚱한 코드에 코멘트가 달린다. 그래서 좁은 허용 범위만 둔다.
    """
    if not line or not postable:
        return None
    if line in postable:
        return line
    near = [p for p in postable if abs(p - line) <= tolerance]
    return min(near, key=lambda p: (abs(p - line), p)) if near else None


def _review_path(path):
    path = (path or "").strip()
    while path.startswith("./"):
        path = path[2:]
    return path


def _scope_findings(findings, files_by_path, strict=True):
    """지적마다 그 좌표가 이 PR 의 변경 안인지 diff 로 가른다 — (남긴 것, 버린 것).

    각 지적에 `_scope` 를 단다: added(추가·수정 라인) / context(diff 안이지만 바뀌지
    않은 문맥 라인) / outside(diff 밖) / unknown(라인 미상). strict 면 outside 와
    변경 파일 목록에 없는 경로는 **반증 전에** 버린다.

    이전에는 이런 지적을 본문으로 강등해 살렸다. 그 결과 base 에 그대로 있던
    코드의 문제가 "이 PR 의 지적" 으로 게시됐다 — 리뷰어 프롬프트가 "변경된 라인만"
    이라고 해도 모델은 워크트리에서 읽은 것을 전부 이 PR 의 것으로 여긴다. 범위는
    모델의 말이 아니라 diff 가 정한다.
    """
    kept, dropped = [], []
    for f in findings or []:
        if not isinstance(f, dict):
            continue
        f = dict(f)
        path = _review_path(f.get("path"))
        entry = files_by_path.get(path)
        line = f.get("line")
        if not entry:
            f["_scope"] = "outside"
            f["_why"] = "변경 파일 목록에 없는 경로"
        elif not line:
            f["_scope"] = "unknown"
        else:
            snapped = _snap_line(line, entry["postable"])
            if not snapped:
                f["_scope"] = "outside"
                f["_why"] = "diff 밖의 라인"
            elif snapped in entry.get("added", ()):
                f["_scope"] = "added"
            else:
                f["_scope"] = "context"
        if strict and f["_scope"] == "outside":
            dropped.append(f)
        else:
            kept.append(f)
    return kept, dropped


def _validate(findings, files_by_path, post_cfg):
    """모델이 준 findings 를 (inline 가능, 요약으로 강등) 으로 가른다."""
    min_sev = SEV.get(post_cfg.get("minSeverity") or "nit", 1)
    inline, demoted, seen = [], [], set()

    for f in findings:
        if not isinstance(f, dict):
            continue
        title = (f.get("title") or "").strip()
        body = (f.get("body") or "").strip()
        if not title or not body:
            continue
        sev = (f.get("severity") or "suggestion").lower()
        if sev not in SEV:
            sev = "suggestion"
        if SEV[sev] < min_sev:
            continue
        f = dict(f, severity=sev, title=title, body=body)

        path = _review_path(f.get("path"))
        entry = files_by_path.get(path)
        if not entry:
            f["_why"] = "변경 파일 목록에 없는 경로"
            demoted.append(f)
            continue

        line = _snap_line(f.get("line"), entry["postable"])
        if not line:
            f["_why"] = "diff 밖의 라인"
            demoted.append(f)
            continue

        key = (path, line, title[:60])
        if key in seen:
            continue
        seen.add(key)
        f["path"], f["line"] = path, line
        inline.append(f)

    order = {"blocking": 0, "suggestion": 1, "nit": 2, "altitude": 3}
    inline.sort(key=lambda x: (order.get(x["severity"], 3), x["path"], x["line"]))
    cap = post_cfg.get("maxFindingsPerPR") or 15
    if len(inline) > cap:
        demoted.extend(dict(x, _why="개수 상한 초과") for x in inline[cap:])
        inline = inline[:cap]
    return inline, demoted


# 내부 severity → 리뷰 규칙의 우선순위 라벨. 모든 인라인 제목에 붙는다.
SEV_LABEL = {"blocking": "P1", "suggestion": "P2", "nit": "P3", "altitude": "altitude"}
# 봇은 코드를 읽기만 한다. 무엇을 안 했는지를 과장 없이 본문에 적는다.
VERIFY_SCOPE = ("워크트리에서 head 커밋의 코드를 정독했습니다 (Read·Grep·Glob). "
                "테스트 실행, 브라우저 검증, 라이브러리 실측은 하지 않았습니다.")


def _label(f):
    return SEV_LABEL.get(f.get("severity"), "P2")


def _loc(f):
    loc = f.get("path") or "-"
    if f.get("line"):
        loc += ":%s" % f["line"]
    return loc


def _comment_body(f):
    body = f["body"]
    if f.get("severity") == "altitude":
        body = "_설계 대안 제시이며, 되돌리자는 제안이 아닙니다._\n\n" + body
    action = {"required": "머지 전 수정 필요", "optional": "선택적 개선", "uncertain": "확인 필요"}[policy.disposition(f)]
    return "%s\n**[%s]** %s · %s\n\n%s" % (MARKER, _label(f), f["title"], action, body)


