                        "못하면 일부 파일은 리뷰어가 워크트리에서 직접 읽습니다")
    r.set_defaults(fn=cmd_review)
    st = sub.add_parser("status")
    st.add_argument("--json", action="store_true", help="앱·스크립트가 읽을 JSON 으로 출력")
    st.add_argument("--fast", action="store_true",
                    help="PR 별 추가 조회(요청자·연결된 이슈)를 건너뛴다")
    st.set_defaults(fn=cmd_status)
    ru = sub.add_parser("runs"); ru.add_argument("-n", "--limit", type=int, default=20)
