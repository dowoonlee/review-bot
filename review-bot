    task.add_argument("action", choices=["start", "complete", "reopen", "cancel", "stop"])
    task.add_argument("target")
    task.add_argument("--account")
    task.add_argument("--direction", choices=["incoming", "outgoing"], default="outgoing")
    task.add_argument("--title")
    task.add_argument("--label")
    task.add_argument("--agent", choices=["codex", "claude", "manual"], default="manual")
    task.add_argument("--session-id", help="연결할 기존 Codex/Claude 세션 UUID")
    task.add_argument("--terminal-id", help="연결할 iTerm 세션 UUID")
    task.set_defaults(fn=cmd_task)
    ai = sub.add_parser("insights", help="Claude 요청 분석 설정 (키는 앱 설정에서 등록)")
    ai.add_argument("action", choices=["status", "enable", "disable", "model", "workspace", "check"])
    ai.add_argument("value", nargs="?")
    ai.set_defaults(fn=cmd_insights)
    r = sub.add_parser("review")
    r.add_argument("target")
    r.add_argument("--rejudge", action="store_true", help="동일 base/head의 코드 검토를 재사용하고 누락 검증·판정만 갱신")
    r.add_argument("--agents", help="이번만 이 리뷰어들로 (쉼표 구분). 빠진 관점만 보완할 때")
    r.add_argument("--note", help="요약 본문 맨 위에 실을 안내 — 왜 또 리뷰가 올라왔는지")
    r.add_argument("--force-size", action="store_true",
