        print("검토 후 게시 (초안만)" if cfg["post"].get("dryRun", True) else "자동 게시")
        return 0
    dry = (args.mode == "draft")
    raw = {}
    if os.path.exists(path):
        try:
            with open(path, encoding="utf-8") as f:
                raw = json.load(f)
        except (ValueError, OSError) as e:
            raise SystemExit("config.json 을 읽지 못했습니다: %s" % e)
    raw.setdefault("post", {})["dryRun"] = dry
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(raw, f, ensure_ascii=False, indent=2)
    os.replace(tmp, path)
    print("검토 후 게시 (초안만)" if dry else "자동 게시")
    return 0


def cmd_cap(args, cfg):
    """틱당 리뷰 상한 조회·변경.

    launchd 를 건드리지 않으므로 도는 틱이 있어도 안전하다. 틱은 시작할 때 설정을
    한 번 읽으므로, 바꾼 값은 다음 틱부터 적용된다.
    """
    path = args.config or os.path.join(cfg_mod.ROOT, "config.json")
    cur = cfg["limits"].get("maxPerTick") or 2
    if args.count is None:
        print("%d건" % cur)
        return 0
    n = args.count
    if n < 1:
        print("최소 1건입니다 — 아예 멈추려면 `review-bot pause` 를 쓰세요")
        return 1
    if n > 20:
        print("최대 20건입니다 — 한 건에 보통 10~20분, $2~9 가 듭니다")
        return 1
    if n == cur:
        print("%d건 (그대로)" % n)
        return 0
    raw = {}
    if os.path.exists(path):
        try:
            with open(path, encoding="utf-8") as f:
                raw = json.load(f)
        except (ValueError, OSError) as e:
            raise SystemExit("config.json 을 읽지 못했습니다: %s" % e)
    raw.setdefault("limits", {})["maxPerTick"] = n
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(raw, f, ensure_ascii=False, indent=2)
    os.replace(tmp, path)
    print("틱당 리뷰 상한 %d건 → %d건" % (cur, n))
    lock = _lock_info()
    if lock and lock.get("alive"):
        print("지금 도는 틱(pid %s)은 이전 상한으로 끝냅니다 — 다음 틱부터 적용됩니다"
              % lock["pid"])
    return 0


def cmd_tick(args, cfg):
    # launchd 가 띄운 틱만 타이머 기준점이 된다 — 손으로 부른 틱은 launchd 의 시계와
    # 무관하다. stdout 이 bot.log 로 리다이렉트돼 있으면 launchd 가 띄운 것이다.
    if _same_file_as_stdout(store.LOG_TEXT):
        store.set_schedule_anchor("launchd-tick", _interval_sec())
    if store.is_paused():
        _log("일시정지 상태입니다 (state/PAUSED). `review-bot resume` 으로 해제하세요.")
        return 0
    if not store.acquire_lock():
        _log("이전 틱이 아직 돌고 있습니다 — 건너뜁니다.")
        return 0
    try:
        return _tick(cfg)
    finally:
        store.release_lock()


def _recover_resources(cfg):
    containers = resources.sweep_containers()
    trees = worktree.sweep(cfg.get('repos'), blocked=containers['blocked'])
    errors = containers['errors'] + trees['errors']
    for error in errors:
        _log('리소스 정리 미완료 — ' + error)
    return containers, trees, errors


def _gc(cfg, verbose=False):
    """부산물을 치운다. 틱마다 조용히 돌고, gc 커맨드로 직접 부를 수도 있다."""
    g = cfg.get("gc") or {}
    out = []
    containers, trees, errors = _recover_resources(cfg)
    swept = trees['removed']
    if containers['removed']:
        out.append('고아 컨테이너 %d개' % len(containers['removed']))
    if swept:
        out.append('워크트리·ref %d건' % swept)
    ns, freed = janitor.sweep_sessions(g.get("sessionDays", 3))
    if ns:
        out.append("claude 세션 %d개 (%s)" % (ns, janitor.human(freed)))
    ne = janitor.prune_evidence(g.get("evidenceDays", 14), blocked=containers["blocked"])
    if ne:
        out.append("실행 검증 자료 %d개" % ne)
    nd = janitor.prune_drafts(g.get("draftDays", 14))
    if nd:
        out.append("초안 %d개" % nd)
    nt = janitor.trim_runs(store.LOG, g.get("runsMaxLines", 2000))
    if nt:
        out.append("이력 %d줄" % nt)
    nv = janitor.trim_runs(store.VERIFY_LOG, g.get("verifyMaxLines", 20000))
    if nv:
        out.append("반증 기록 %d줄" % nv)
    if janitor.rotate_logs(g.get("logMaxBytes", 5000000)):
        out.append("로그 로테이션")
    nl, lfreed = janitor.prune_day_logs(g.get("logDays", 30))
    if nl:
        out.append("지난 로그 %d일치 (%s)" % (nl, janitor.human(lfreed)))
    nc, cfreed = janitor.sweep_cache_repos(cfg.get("repos"))
    if nc:
        out.append("캐시 클론 %d개 (%s)" % (nc, janitor.human(cfreed)))
    state = store.load()
    npr = janitor.prune_reviewed(state, g.get("reviewedDays", 90))
    if npr:
        store.save(state)
        out.append("오래된 기록 %d건" % npr)
    if out and (verbose or swept):
        _log("정리: " + " · ".join(out))
    elif verbose and not errors:
        _log("정리할 것 없음")
    if errors:
        _log('정리 미완료 %d건 — 다음 실행에서 다시 회수합니다.' % len(errors))
    return {'cleaned': out, 'errors': errors}


def cmd_gc(args, cfg):
    if not store.acquire_lock():
        _log('리뷰가 실행 중이라 정리하지 않습니다. 완료 후 다시 실행하세요.')
        return 1
    try:
        report = _gc(cfg, verbose=True)
        return 1 if report['errors'] else 0
    finally:
        store.release_lock()


def _accounts(cfg):
    """계정 → 그 계정으로 다루는 저장소 집합. None 은 전역 활성 gh 를 뜻한다."""
    groups = {}
    for repo, entry in (cfg.get("repos") or {}).items():
        if (entry or {}).get("enabled") is False:
            continue
        acct = (entry or {}).get("account") or cfg.get("account")
        groups.setdefault(acct, set()).add(repo)
    return groups


def _tick(cfg):
    for error in drafts_mod.reconcile(cfg, locked=True):
        _log(error)
    _gc(cfg)
    state = store.load()

    # 계정마다 따로 조회한다. 리뷰 요청은 @me 기준이라 계정이 다르면 목록이 다르다.
    targets, total = [], 0
    insight_targets, issue_targets = [], []
    for acct, repos in _accounts(cfg).items():
        try:
            me = gh.whoami(acct)
            if not me:
                raise gh.GhError("현재 계정을 확인할 수 없습니다")
            if acct:
                if (me or "").lower() != acct.lower():
                    _log("계정 %s 의 토큰 주인이 %s 입니다 — 이 계정의 저장소는 건너뜁니다"
                         % (acct, me or "?"))
                    continue
        except gh.GhError as e:
            _log("계정 확인 실패 (%s): %s" % (acct or "전역 gh", e))
            continue
        # 답변 확인이 오래 걸리는 코드 리뷰 뒤로 밀리지 않도록 두 조회부터 끝낸다.
        with ThreadPoolExecutor(max_workers=2) as pool:
            received = pool.submit(gh.review_requests, account=acct)
            sent = pool.submit(gh.sent_review_requests, account=acct)
            try:
                prs = received.result()
                total += len(prs)
                targets += [p for p in prs if p["repo"] in repos]
                insight_targets.extend((acct, p, "incoming") for p in prs if p["repo"] in repos)
            except gh.GhError as e:
                _log("리뷰 요청 조회 실패 (%s): %s" % (acct or "전역 gh", e))
            try:
                outgoing, warnings = sent.result()
                _log("보낸 PR %d건 리뷰 답변 확인" % len(outgoing))
                for warning in warnings:
                    _log("리뷰 답변 조회 주의: " + warning)
                replies.check(outgoing, me, cfg.get("notify") or {}, _log)
                insight_targets.extend((acct, p, "outgoing") for p in outgoing if p["repo"] in repos)
            except (gh.GhError, OSError, ValueError) as e:
                _log("리뷰 답변 확인 실패 (%s): %s" % (acct or "전역 gh", e))
        try:
            assigned, _warnings = gh.assigned_issues(account=acct)
            issue_targets.extend((acct, i) for i in assigned)
        except gh.GhError as e:
            _log("담당 이슈 조회 실패 (%s): %s" % (acct or "전역 gh", e))
    try:
        insights.refresh(insight_targets, cfg, _log)
    except Exception:
        _log("요청 분석 실패 — 기존 리뷰를 계속합니다")
    try:
        selection.refresh(insight_targets, cfg, _log)
    except Exception:
        _log("Jev 분류 실패 — 기존 리뷰를 계속합니다")
    try:
        issues_mod.refresh(issue_targets, cfg, _log)
    except Exception:
        _log("Jev 이슈 분류 실패 — 기존 리뷰를 계속합니다")
    by_pr = {(p['repo'], p['number']): p for p in targets}
    for pending in checkpoints.watching(cfg):
        by_pr[(pending['repo'], pending['number'])] = pending
    targets = list(by_pr.values())
    _log("리뷰 요청 %d건 (감시 대상 %d건)" % (total, len(targets)))

    cap = cfg["limits"].get("maxPerTick") or 2
    done, reviewed = [], 0

    # 볼 PR 이 있을 때만 붙인다 — 조용한 틱마다 사내 서버를 찌를 이유가 없다.
    mcp = None
    if targets:
        mcp, blocked = _connect_repomind(cfg)
        if blocked:
            return 1

    for pr in targets:
        if reviewed >= cap:
            _log("틱당 상한 %d건 도달 — 나머지는 다음 틱에" % cap)
            break
        _log("· %s#%s %s" % (pr["repo"], pr["number"], pr["title"][:50]))
        try:
            r = process_pr(pr, cfg, state, mcp=mcp)
        except (gh.GhError, worktree.WorktreeError, reviewer.ReviewError) as e:
            _log("  실패: %s" % str(e)[:200])
            store.log_run({"repo": pr["repo"], "number": pr["number"],
                           "error": str(e)[:300]})
            continue
        if r.get("skipped"):
            _log("  건너뜀 — %s" % r["skipped"])
            _announce_skip(r, cfg, state)
            continue
        reviewed += 1
        done.append(r)
        store.mark(state, r["repo"], r["number"], r["sha"],
                   inline=r.get("inline"), demoted=r.get("demoted"),
                   posted=r.get("posted"), cost_usd=r.get("cost_usd"),
                   requestedAt=r.get("requestedAt"), event=r.get("event"), pending=r.get("pending", False), decision=r.get("decision"))
        store.save(state)
        store.log_run(r)
        where = "검증 대기" if r.get("pending") else "초안" if r.get("draft") else ("게시" if r.get("posted") else "-")
        _log("  %s — %s · inline %d · 요약 %d"
             % (where, EVENT_LABEL.get(r.get("event"), r.get("event") or "-"),
                r.get("inline") or 0, r.get("demoted") or 0))

    done = [r for r in done if not r.get("pending")]
    if done and cfg["notify"].get("enabled", True):
        head = done[0]
        title = "리뷰 %d건 %s" % (len(done), "초안" if head.get("draft") else "게시")
        msg = "; ".join("%s#%s → %d건" % (d["repo"].split("/")[-1], d["number"],
                                          (d.get("inline") or 0) + (d.get("demoted") or 0))
                        for d in done)
        notify.send("review-bot · " + title, msg,
                    sound=cfg["notify"].get("sound"), enabled=True)
    if not done:
        _log("새로 리뷰할 PR 없음")
    return 0


def _parse_target(s):
    s = s.strip()
    if "/pull/" in s:
        parts = s.split("/")
        i = parts.index("pull")
        return "%s/%s" % (parts[i - 2], parts[i - 1]), int(parts[i + 1])
    if "#" in s:
        repo, num = s.split("#", 1)
        return repo, int(num)
    raise SystemExit("PR 을 owner/repo#123 또는 PR URL 로 지정하세요")


def _narrow(cfg, agent_csv, note):
    """이번 실행에만 적용할 설정 — 리뷰어를 좁히고, 본문에 실을 안내를 단다."""
    out = cfg
    if agent_csv:
        names = [a.strip() for a in agent_csv.split(",") if a.strip()]
        for name in names:
            try:
                agents_mod.load(name)
            except agents_mod.AgentError as e:
                raise SystemExit(str(e))
        out = dict(out, review=dict(out["review"], agents=names))
    if note:
        out = dict(out, post=dict(out["post"], note=note))
    return out


def cmd_review(args, cfg):
    """PR 하나를 지금 리뷰한다. 이미 리뷰한 커밋이어도 강제로 다시 본다.

    틱과 같은 lock 을 잡는다. 겹치면 sweep 이 틱이 쓰고 있는 워크트리를 지워
    버리고, 같은 PR 을 둘이 리뷰해 같은 지적을 두 번 게시하기 때문이다.
    일시정지(PAUSED)는 보지 않는다 — 손으로 부르는 명령은 사람의 의도다.
    """
    repo, number = _parse_target(args.target)
    cfg = _narrow(cfg, getattr(args, "agents", None), getattr(args, "note", None))
    if not store.acquire_lock():
        _log("틱이 돌고 있습니다 — 끝난 뒤 다시 부르거나 `review-bot pause` 로 멈추세요.")
        return 1
    try:
        _recover_resources(cfg)
        state = store.load()
        pr = {"repo": repo, "number": number, "title": ""}
        mcp, blocked = _connect_repomind(cfg)
        if blocked:
            return 1
        try:
            r = process_pr(pr, cfg, state, force=True, mcp=mcp,
                           force_size=getattr(args, "force_size", False),
                           rejudge=getattr(args, "rejudge", False))
        except (gh.GhError, worktree.WorktreeError, reviewer.ReviewError) as e:
            _log("실패: %s" % str(e)[:300])
            store.log_run({"repo": repo, "number": number, "error": str(e)[:300]})
            return 1
        if r.get("skipped"):
            _log("건너뜀 — %s" % r["skipped"])
            if r.get("skipKind") == "size":
                _log("상한을 무시하고 보려면 --force-size 를 붙이세요")
            return 0
        store.mark(state, repo, number, r["sha"], inline=r.get("inline"),
                   demoted=r.get("demoted"), posted=r.get("posted"),
                   cost_usd=r.get("cost_usd"),
                   requestedAt=r.get("requestedAt"), event=r.get("event"), pending=r.get("pending", False), decision=r.get("decision"))
        store.save(state)
        store.log_run(r)
        print(json.dumps(r, ensure_ascii=False, indent=2))
        return 0
    finally:
        store.release_lock()


LAUNCHD_LABEL = "com.review-bot.agent"


def _plist_path():
    return os.path.expanduser("~/Library/LaunchAgents/%s.plist" % LAUNCHD_LABEL)


def _interval_sec():
    """틱 주기. launchd plist 가 유일한 사실이다."""
    try:
        with open(_plist_path(), "rb") as f:
            return plistlib.load(f).get("StartInterval")
    except (OSError, ValueError, plistlib.InvalidFileException):
        return None


def _agent_info(names, model_cfg=None):
    """설정된 리뷰어들이 실제로 어떤 정의를 물고 있는지.

    frontmatter 의 model 과 tools 는 참고용이다 — 봇은 모델을 config 로 덮고
    도구는 reviewer.ALLOWED_TOOLS 로 고정한다. 둘 다 보여 줘야 오해가 없다.
    `runsAs` 가 그 리뷰어가 실제로 도는 모델이다.
    """
    out = []
    for name in names:
        info = {"name": name, "exists": False, "tools": [], "description": "",
                "model": "", "runsAs": cfg_mod.model_for(model_cfg, name),
                "role": ""}
        try:
            meta, body = agents_mod.load(name)
            info["exists"] = True
            info["description"] = meta.get("description") or ""
            info["model"] = meta.get("model") or ""
            raw = (meta.get("tools") or "").strip().strip("[]")
            info["tools"] = [t.strip() for t in raw.split(",") if t.strip()]
            lines = [l for l in body.splitlines() if l.strip() and not l.startswith("#")]
            info["role"] = "\n".join(lines[:5])[:400]
            info["path"] = os.path.join(agents_mod.AGENTS_DIR, name + ".md")
        except agents_mod.AgentError as e:
            info["error"] = str(e)
        out.append(info)
    return out


def _model_summary(m):
    """에이전트별 dict 를 한 줄로 접는다.

    status 는 사람이 읽는 화면이고, 이 값을 읽는 설정 앱도 문자열을 기대한다.
    구조화된 원본이 필요하면 `modelByAgent` 를 본다.
    """
    if not isinstance(m, dict):
        return m or "opus"
    rest = ["%s: %s" % (k, v) for k, v in sorted(m.items()) if k != "default"]
    base = m.get("default") or "opus"
    return "%s (%s)" % (base, ", ".join(rest)) if rest else base


